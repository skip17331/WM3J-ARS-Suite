<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ars</groupId>
    <artifactId>ars-fx</artifactId>
    <version>1.13.6</version>
    <packaging>jar</packaging>
    <name>ARS Suite — JavaFX shell + core surfaces</name>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <javafx.version>21.0.3</javafx.version>
        <!-- JavaFX native/platform classifier resolved from Maven (desktop x86_64 = linux). -->
        <javafx.platform>linux</javafx.platform>
        <!-- shaded-jar packaging knobs (overridden by -Ppi):
             dist     = output name suffix (target/ars-fx-<dist>.jar)
             fx.scope = scope of the JavaFX deps. compile → bundled in the desktop jar;
                        pi sets it to provided so shade leaves JavaFX out (OpenJFX ships
                        no ARM-Linux jar to Maven — it comes from a Liberica Full JDK on
                        the Pi). The transitive JavaFX in j-digi is excluded
                        below so it can never sneak back in. -->
        <dist>linux</dist>
        <fx.scope>compile</fx.scope>
        <!-- start surface; override: mvn javafx:run -Dsurface=map -->
        <surface>hub</surface>
    </properties>

    <dependencies>
        <!-- JavaFX with the per-OS native classifier (set by ${javafx.platform}; default linux,
             overridden by the win/mac/mac-aarch64 profiles). OpenJFX's classified POMs are
             self-referential — javafx-base:win transitively pulls javafx-base:linux etc. — so we
             exclude transitive org.openjfx and keep only these three explicit, correctly-classified
             jars. Without this every per-OS build leaks the linux natives into its fat jar. -->
        <dependency><groupId>org.openjfx</groupId><artifactId>javafx-base</artifactId><version>${javafx.version}</version><classifier>${javafx.platform}</classifier><scope>${fx.scope}</scope>
            <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions></dependency>
        <dependency><groupId>org.openjfx</groupId><artifactId>javafx-graphics</artifactId><version>${javafx.version}</version><classifier>${javafx.platform}</classifier><scope>${fx.scope}</scope>
            <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions></dependency>
        <dependency><groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId><version>${javafx.version}</version><classifier>${javafx.platform}</classifier><scope>${fx.scope}</scope>
            <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions></dependency>
        <!-- shares ~/.j-log/j-log.db with the J-Log module (same schema/driver) -->
        <dependency><groupId>org.xerial</groupId><artifactId>sqlite-jdbc</artifactId><version>3.46.0.0</version></dependency>
        <!-- sqlite-jdbc 3.46's JDBC clinit references slf4j; api-only → NOP fallback -->
        <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><version>2.0.13</version></dependency>
        <!-- J-Sat satellite registry + ~/.j-sat settings JSON parsing -->
        <dependency><groupId>com.google.code.gson</groupId><artifactId>gson</artifactId><version>2.10.1</version></dependency>
        <!-- Contest mode reuses the pure scoring/plugin/Cabrillo engine. Pinned explicitly so the API version is deterministic. -->
        <dependency><groupId>com.jlog</groupId><artifactId>j-log-engine</artifactId><version>1.13.6</version>
            <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions></dependency>
        <!-- J-Digi embeds the real modem engine (ModemService); same JavaFX/gson/slf4j versions.
             Exclude its transitive JavaFX so our scoped (compile/provided) JavaFX is the only one. -->
        <dependency><groupId>com.hamradio</groupId><artifactId>j-digi</artifactId><version>1.13.6</version>
            <exclusions><exclusion><groupId>org.openjfx</groupId><artifactId>*</artifactId></exclusion></exclusions></dependency>
        <!-- J-Bridge: the WSJT-X UDP listener + decode/status models (a thin library) -->
        <dependency><groupId>com.hamradio</groupId><artifactId>j-bridge</artifactId><version>1.13.6</version></dependency>
        <!-- Solo J-Map/J-Sat ⇄ station J-Hub link (same WS lib the suite's central hub uses) -->
        <dependency><groupId>org.java-websocket</groupId><artifactId>Java-WebSocket</artifactId><version>1.5.6</version></dependency>
        <!-- PluginLoader/ContestPlugin parse contest JSON with Jackson; pin so the shade keeps it. -->
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>2.17.0</version>
            <!-- 2.17.0's pom wrongly lists byte-buddy as a compile dependency; nothing here uses it -->
            <exclusions><exclusion><groupId>net.bytebuddy</groupId><artifactId>byte-buddy</artifactId></exclusion></exclusions></dependency>
        <!-- Morse trainer (J-Learn): serial port for the Arduino paddle keyer -->
        <dependency><groupId>com.fazecast</groupId><artifactId>jSerialComm</artifactId><version>2.10.4</version></dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource><directory>src/main/resources</directory><excludes><exclude>com/ars/fx/version.properties</exclude></excludes></resource>
            <!-- the one filtered file: stamps the build version into the jar so the app can report it and check for updates -->
            <resource><directory>src/main/resources</directory><filtering>true</filtering><includes><include>com/ars/fx/version.properties</include></includes></resource>
            <!-- the J-Learn chapters live in their own repo folder (so they can be updated on their own); a copy ships in
                 the jar so a fresh install has content and can restore it -->
            <resource><directory>${project.basedir}/../j-learn-content</directory><targetPath>com/ars/fx/learn/content</targetPath></resource>
            <!-- the licence, Code of Conduct and legal notes live at the repo root; a copy ships in the jar so the app shows them
                 without a web link and refreshes its local copies when an update is downloaded (LegalDocs) -->
            <resource><directory>${project.basedir}/..</directory><targetPath>com/ars/fx/legal</targetPath>
                <includes><include>LICENSE</include><include>CodeOfConduct.md</include><include>LEGAL.md</include></includes></resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- the modem keeps its settings in Java Preferences; tests must never touch the user's real ones -->
                    <argLine>-Djava.util.prefs.userRoot=${project.build.directory}/test-prefs</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.ars.fx.Launcher</mainClass>
                    <options>
                        <option>-Dsurface=${surface}</option>
                    </options>
                </configuration>
            </plugin>
            <!-- Runnable jar: app + all deps in one file.
                 `mvn -q package`       → target/ars-fx-linux.jar  (desktop x86_64, JavaFX bundled — plain JDK)
                 `mvn -q -Ppi package`  → target/ars-fx-pi.jar     (no JavaFX — run on a Liberica Full JDK on the Pi) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <finalName>ars-fx-${dist}</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.ars.fx.Main</mainClass>
                                    <manifestEntries>
                                        <!-- shown natively by the JVM the instant `java -jar` starts, before JavaFX is up; the
                                             app closes it once its first window shows (AppIcons.closeSplash) -->
                                        <SplashScreen-Image>com/ars/fx/icons/splash.png</SplashScreen-Image>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Per-desktop-OS builds. Each overrides the JavaFX native classifier and the
             output jar suffix; JavaFX stays bundled (fx.scope=compile) so the jar runs on
             a plain JDK. Build: mvn -P<id> clean package → target/ars-fx-<dist>.jar
                 (default, no -P)  → ars-fx-linux.jar         desktop Linux x86-64
                 -Pwin             → ars-fx-windows.jar       Windows x86-64
                 -Pmac             → ars-fx-mac.jar           macOS Intel
                 -Pmac-aarch64     → ars-fx-mac-aarch64.jar   macOS Apple Silicon -->
        <profile>
            <id>win</id>
            <properties><dist>windows</dist><javafx.platform>win</javafx.platform></properties>
        </profile>
        <profile>
            <id>mac</id>
            <properties><dist>mac</dist><javafx.platform>mac</javafx.platform></properties>
        </profile>
        <profile>
            <id>mac-aarch64</id>
            <properties><dist>mac-aarch64</dist><javafx.platform>mac-aarch64</javafx.platform></properties>
        </profile>
        <!-- Raspberry Pi (64-bit Pi OS / aarch64): mvn -Ppi clean package.
             OpenJFX publishes no ARM-Linux jar to Maven, so JavaFX is left out of
             the jar and supplied by a Liberica Full JDK 21 on the Pi (see launch/README). -->
        <profile>
            <id>pi</id>
            <properties>
                <dist>pi</dist>
                <fx.scope>provided</fx.scope>
            </properties>
        </profile>
    </profiles>
</project>

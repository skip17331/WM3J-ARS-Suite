<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hamradio.ars</groupId>
    <artifactId>j-installer</artifactId>
    <version>2.0.0</version>
    <packaging>jar</packaging>
    <name>ARS Suite Installer</name>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>
        <!-- JUnit 5 (test scope only; not shaded into the installer jar) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>j-installer-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.hamradio.ars.installer.Installer</mainClass>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- the launchers and icons the no-build install writes, taken from the app's own sources so there is one copy of each -->
            <resource>
                <directory>../ars-fx</directory>
                <includes><include>ars-fx.sh</include><include>ars-fx.bat</include></includes>
                <targetPath>standalone</targetPath>
            </resource>
            <resource>
                <directory>../ars-fx/src/main/resources/com/ars/fx/icons</directory>
                <includes>
                    <include>suite.png</include><include>log.png</include><include>map.png</include><include>sat.png</include>
                    <include>digi.png</include><include>vault.png</include><include>learn.png</include>
                </includes>
                <targetPath>standalone/icons</targetPath>
            </resource>
        </resources>
    </build>
</project>

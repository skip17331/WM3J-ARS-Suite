{
  "contestId":   "ARRL_EME",
  "contestName": "ARRL International EME Contest",
  "version":     "1.0.0",

  "exchangeFormat": "Both stations send 4-char grid via EME (e.g. EN50). Optional signal report if grids can't be exchanged. 100 pts/QSO; multiplier = grids per band.",

  "roverAwareDupe": true,

  "entryFields": [
    { "id": "callsign", "label": "Callsign", "type": "text", "width": 140, "required": true, "entryRow": 0 },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 80, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["6m","2m","1.25m","70cm","33cm","23cm","13cm","9cm","6cm","3cm","1cm"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 80, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW","SSB","JT65","Q65","FT8","Digital"]
    },
    {
      "id": "grid_rcvd", "label": "Grid R", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "validator": "maidenhead"
    },
    {
      "id": "grid_sent", "label": "Grid S", "type": "text",
      "width": 70, "required": true, "entryRow": 1,
      "persistent": true,
      "validator": "maidenhead"
    }
  ],

  "scoringRules": {
    "pointsPerQso":  100,
    "modePoints":    {},
    "multiplierType": "custom",
    "scoreFormula":  "qsoPoints * multipliers (Rule 5.3: 100 pts/QSO × sum of distinct 4-char grids worked per band)",
    "allowDupes":    false
  },

  "multiplierModel": {
    "field":   "grid_rcvd",
    "perBand": true,
    "validValues": []
  },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "grid_map",      "title": "Worked Grids (per band)", "config": {} },
    { "paneIndex": 3, "paneType": "statistics",    "title": "Statistics", "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloMapping": {
    "callsign":   "rcvd_callsign",
    "grid_sent":  "sent_exchange",
    "grid_rcvd":  "rcvd_exchange"
  },

  "sections": []
}

{
  "contestId":   "ARRL_160M",
  "contestName": "ARRL 160-Meter Contest",
  "version":     "1.0.0",

  "exchangeFormat": "US/VE: RST + State/Prov   DX: RST + DX   (e.g. 599 PA, 599 ON, 599 DX)",

  "lockedBand":  "160m",
  "lockedMode":  "CW",
  "perModeMultipliers": false,
  "stationClassifier":  "callsignRegion",
  "autoFillDxccPrefix": true,

  "entryFields": [
    {
      "id": "callsign", "label": "Callsign", "type": "text",
      "width": 140, "required": true, "entryRow": 0
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 60, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW"]
    },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": false, "entryRow": 0,
      "persistent": true,
      "options": ["160m"]
    },
    {
      "id": "rst_rcvd", "label": "RST R", "type": "text",
      "width": 50, "required": true, "entryRow": 0
    },
    {
      "id": "state_prov_rcvd", "label": "St/Pv/DX", "type": "text",
      "width": 70, "required": true, "entryRow": 0
    },
    {
      "id": "rst_sent", "label": "RST S", "type": "text",
      "width": 50, "required": true, "entryRow": 1
    },
    {
      "id": "state_prov_sent", "label": "St/Pv/DX", "type": "text",
      "width": 70, "required": false, "entryRow": 1,
      "persistent": true
    }
  ],

  "scoringRules": {
    "pointsPerQso":  2,
    "modePoints":    {},
    "pointsByRegionPair": {
      "US_US": 2, "US_CA": 2, "US_DX": 5,
      "CA_US": 2, "CA_CA": 2, "CA_DX": 5,
      "DX_US": 5, "DX_CA": 5, "DX_DX": 2
    },
    "multiplierType": "custom",
    "scoreFormula":  "qsoPoints * multipliers",
    "allowDupes":    false
  },

  "multiplierModel": {
    "field":  "state_prov_rcvd",
    "perBand": false,
    "validValues": [
      "AL","AK","AZ","AR","CA","CO","CT","DE","FL","GA",
      "HI","ID","IL","IN","IA","KS","KY","LA","ME","MD",
      "MA","MI","MN","MS","MO","MT","NE","NV","NH","NJ",
      "NM","NY","NC","ND","OH","OK","OR","PA","RI","SC",
      "SD","TN","TX","UT","VT","VA","WA","WV","WI","WY",
      "AB","BC","MB","NB","NL","NS","NT","NU","ON","PE","QC","SK","YT"
    ]
  },

  "usStates": [
    "AL","AK","AZ","AR","CA","CO","CT","DE","FL","GA",
    "HI","ID","IL","IN","IA","KS","KY","LA","ME","MD",
    "MA","MI","MN","MS","MO","MT","NE","NV","NH","NJ",
    "NM","NY","NC","ND","OH","OK","OR","PA","RI","SC",
    "SD","TN","TX","UT","VT","VA","WA","WV","WI","WY"

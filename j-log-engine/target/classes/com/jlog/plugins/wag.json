{
  "contestId":   "WAG",
  "contestName": "Worked All Germany Contest",
  "version":     "1.0.0",

  "exchangeFormat": "DL: RST + DOK (e.g. 599 A01)   DX: RST + serial (e.g. 599 001)",

  "stationClassifier":  "callsignRegion",
  "autoFillDxccPrefix": true,

  "entryFields": [
    { "id": "callsign", "label": "Callsign", "type": "text", "width": 140, "required": true, "entryRow": 0 },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["160m","80m","40m","20m","15m","10m"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW","SSB","USB","LSB"]
    },
    { "id": "rst_rcvd", "label": "RST R", "type": "text", "width": 50, "required": false, "entryRow": 0 },
    { "id": "state_prov_rcvd", "label": "DOK/DXCC", "type": "text", "width": 80, "required": true, "entryRow": 0 },
    { "id": "serial_rcvd", "label": "# R", "type": "text", "width": 60, "required": false, "entryRow": 0, "validator": "numeric" },
    { "id": "rst_sent", "label": "RST S", "type": "text", "width": 50, "required": false, "entryRow": 1 },
    { "id": "state_prov_sent", "label": "DOK S", "type": "text", "width": 80, "required": false, "entryRow": 1, "persistent": true }
  ],

  "conditionalFields": [
    { "fieldId": "serial_rcvd", "showForRegions": ["US","CA","DX"] }
  ],

  "scoringRules": {
    "pointsPerQso": 3,
    "modePoints":   {},
    "multiplierType": "custom",
    "scoreFormula": "qsoPoints * multipliers",
    "allowDupes":   false
  },

  "multiplierModel": {
    "field":   "state_prov_rcvd",
    "perBand": true,
    "validValues": []
  },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "dxcc_list",     "title": "DOKs / DXCC",   "config": {} },
    { "paneIndex": 3, "paneType": "statistics",    "title": "Statistics",    "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloMapping": {
    "callsign":        "rcvd_callsign",
    "rst_sent":        "sent_rst",
    "rst_rcvd":        "rcvd_rst",
    "state_prov_sent": "sent_exchange",
    "state_prov_rcvd": "rcvd_exchange",
    "serial_rcvd":     "rcvd_exchange"
  },

  "sections": []
}

{
  "contestId":   "SAC_CW",
  "contestName": "Scandinavian Activity Contest (CW)",
  "version":     "1.0.0",

  "exchangeFormat": "RST + serial  (e.g. 599 001). Work Scandinavians only.",

  "lockedMode":         "CW",
  "autoFillDxccPrefix": true,

  "entryFields": [
    { "id": "callsign", "label": "Callsign", "type": "text", "width": 140, "required": true, "entryRow": 0 },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["160m","80m","40m","20m","15m","10m"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 60, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW"]
    },
    { "id": "rst_rcvd",    "label": "RST R", "type": "text", "width": 50, "required": false, "entryRow": 0 },
    { "id": "serial_rcvd", "label": "# R",   "type": "text", "width": 60, "required": true,  "entryRow": 0, "validator": "numeric" },
    {
      "id": "state_prov_rcvd", "label": "Scand Pfx", "type": "text",
      "width": 70, "required": false, "entryRow": 0,
      "options": ["OH","OH0","OJ0","LA","JW","JX","OZ","OX","OY","SM","TF"]
    },
    { "id": "rst_sent",    "label": "RST S", "type": "text", "width": 50, "required": false, "entryRow": 1 }
  ],

  "scoringRules": {
    "pointsPerQso": 1,
    "modePoints":   {},
    "pointsByBand": { "160m": 3, "80m": 3, "40m": 1, "20m": 1, "15m": 1, "10m": 3 },
    "multiplierType": "custom",
    "scoreFormula": "qsoPoints * multipliers",
    "allowDupes":   false
  },

  "multiplierModel": {
    "field":   "state_prov_rcvd",
    "perBand": true,
    "validValues": [
      "OH","OH0","OJ0","LA","JW","JX","OZ","OX","OY","SM","TF"
    ]
  },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "dxcc_list",     "title": "Scandinavian Prefixes", "config": {} },
    { "paneIndex": 3, "paneType": "statistics",    "title": "Statistics",    "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloMapping": {
    "callsign":    "rcvd_callsign",
    "rst_sent":    "sent_rst",
    "rst_rcvd":    "rcvd_rst",
    "serial_rcvd": "rcvd_exchange"
  },

  "sections": []
}

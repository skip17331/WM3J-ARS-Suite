{
  "contestId":   "RAC_CANADA_DAY",
  "contestName": "RAC Canada Day Contest",
  "version":     "1.0.0",

  "exchangeFormat": "VE: RST + Province   DX: RST + Serial  (e.g. 59 ON, 599 001)",

  "stationClassifier":  "callsignRegion",
  "autoFillDxccPrefix": true,

  "entryFields": [
    {
      "id": "callsign", "label": "Callsign", "type": "text",
      "width": 140, "required": true, "entryRow": 0
    },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["160m","80m","40m","20m","15m","10m","6m","2m"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW","SSB","USB","LSB","FM","FT8","FT4","RTTY","PSK31","Digital"]
    },
    {
      "id": "rst_rcvd", "label": "RST R", "type": "text",
      "width": 50, "required": false, "entryRow": 0
    },
    {
      "id": "state_prov_rcvd", "label": "Prov R", "type": "text",
      "width": 70, "required": false, "entryRow": 0
    },
    {
      "id": "serial_rcvd", "label": "# R", "type": "text",
      "width": 60, "required": false, "entryRow": 0,
      "validator": "numeric"
    },
    {
      "id": "rst_sent", "label": "RST S", "type": "text",
      "width": 50, "required": false, "entryRow": 1
    },
    {
      "id": "state_prov_sent", "label": "Prov S", "type": "text",
      "width": 70, "required": false, "entryRow": 1,
      "persistent": true
    }
  ],

  "conditionalFields": [
    { "fieldId": "state_prov_rcvd", "showForRegions": ["US","CA"] },
    { "fieldId": "serial_rcvd",     "showForRegions": ["DX"] }
  ],

  "scoringRules": {
    "pointsPerQso":  2,
    "modePoints":    { "CW": 2, "SSB": 2, "USB": 2, "LSB": 2, "FM": 2, "FT8": 2, "RTTY": 2 },
    "multiplierType": "custom",
    "scoreFormula":  "qsoPoints * multipliers",
    "allowDupes":    false
  },

  "multiplierModel": {
    "field":   "state_prov_rcvd",
    "perBand": true,
    "validValues": [
      "AB","BC","MB","NB","NL","NS","NT","NU","ON","PE","QC","SK","YT"
    ]
  },

  "canadaProvinces": [
    "AB","BC","MB","NB","NL","NS","NT","NU","ON","PE","QC","SK","YT"
  ],

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "canada_map",    "title": "Canadian Provinces", "config": {} },
    { "paneIndex": 3, "paneType": "statistics",    "title": "Statistics", "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloMapping": {
    "callsign":        "rcvd_callsign",
    "rst_sent":        "sent_rst",
    "rst_rcvd":        "rcvd_rst",
    "state_prov_sent": "sent_exchange",
    "state_prov_rcvd": "rcvd_exchange",
    "serial_rcvd":     "rcvd_exchange"
  },

  "sections": []
}

{
  "contestId":   "ALL_ASIAN_DX_CW",
  "contestName": "All Asian DX Contest (CW)",
  "version":     "1.1.0",

  "exchangeFormat": "RST + operator age (2 digits; send 01 if withholding). e.g. 599 25 / 599 01 (§5).",

  "lockedMode": "CW",

  "entryFields": [
    { "id": "callsign", "label": "Callsign", "type": "text", "width": 140, "required": true, "entryRow": 0 },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0, "persistent": true,
      "options": ["160m","80m","40m","20m","15m","10m"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 60, "required": true, "entryRow": 0, "persistent": true,
      "options": ["CW"]
    },
    { "id": "rst_rcvd", "label": "RST R", "type": "text", "width": 50, "required": true, "entryRow": 0 },
    { "id": "age_rcvd", "label": "Age R", "type": "text", "width": 45, "required": true, "entryRow": 0, "validator": "numeric" },
    { "id": "rst_sent", "label": "RST S", "type": "text", "width": 50, "required": true, "entryRow": 1 },
    { "id": "age_sent", "label": "Age S", "type": "text", "width": 45, "required": false, "entryRow": 1, "persistent": true, "validator": "numeric" }
  ],

  "scoringRules": {
    "pointsPerQso": 1,
    "multiplierType": "all_asian",
    "scoreFormula": "Σ QSO pts (all bands) × Σ mults (all bands), §8. Pts §7: Asian entrant — same-entity 0, Asian QSO 3/2/2/1 (160 / 80,10 / other), non-Asian QSO 9/6/6/3; non-Asian entrant — Asian-only 3/2/2/1. Mult §7: Asian entrant = distinct DXCC entities/band; non-Asian = distinct Asian WPX prefixes/band. Claimed — JARL re-adjudicates.",
    "allowDupes": false
  },

  "multiplierModel": { "field": "callsign", "perBand": true, "validValues": [] },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "statistics",    "title": "Statistics",    "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloSent": ["rst_sent", "age_sent"],
  "cabrilloRcvd": ["rst_rcvd", "age_rcvd"],

  "sections": []
}

{
  "contestId":   "ALL_ASIAN_DX_CW",
  "contestName": "All Asian DX Contest (CW)",
  "version":     "1.0.0",

  "exchangeFormat": "RST + age (2 digits)  (e.g. 599 42). Operators <= 25 earn bonuses.",

  "lockedMode":         "CW",
  "autoFillWpxPrefix":  true,

  "entryFields": [
    { "id": "callsign", "label": "Callsign", "type": "text", "width": 140, "required": true, "entryRow": 0 },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["160m","80m","40m","20m","15m","10m"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 60, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW"]
    },
    { "id": "rst_rcvd", "label": "RST R", "type": "text", "width": 50, "required": false, "entryRow": 0 },
    { "id": "age_rcvd", "label": "Age R", "type": "text", "width": 45, "required": true,  "entryRow": 0, "validator": "numeric" },
    { "id": "prefix_rcvd", "label": "Prefix", "type": "text", "width": 70, "required": false, "entryRow": 0 },
    { "id": "rst_sent", "label": "RST S", "type": "text", "width": 50, "required": false, "entryRow": 1 },
    { "id": "age_sent", "label": "Age S", "type": "text", "width": 45, "required": false, "entryRow": 1, "persistent": true, "validator": "numeric" }
  ],

  "scoringRules": {
    "pointsPerQso": 1,
    "modePoints":   {},
    "multiplierType": "custom",
    "scoreFormula": "qsoPoints * multipliers",
    "allowDupes":   false
  },

  "multiplierModel": {
    "field":   "prefix_rcvd",
    "perBand": true,
    "validValues": []
  },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "statistics",    "title": "Statistics",    "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloMapping": {
    "callsign": "rcvd_callsign",
    "rst_sent": "sent_rst",
    "rst_rcvd": "rcvd_rst",
    "age_sent": "sent_exchange",
    "age_rcvd": "rcvd_exchange"
  },

  "sections": []
}

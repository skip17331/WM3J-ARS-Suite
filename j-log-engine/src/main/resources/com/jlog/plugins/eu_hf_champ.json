{
  "contestId":   "EU_HF_CHAMP",
  "contestName": "EU HF Championship",
  "version":     "1.1.0",

  "exchangeFormat": "RS(T) + two-digit year of operator's first ever licence (§5; e.g. 599 82 = first licensed 1982, 17 = 2017). Mixed CW+SSB, 160-10m no WARC. European contacts only (§1).",

  "entryFields": [
    { "id": "callsign", "label": "Callsign", "type": "text", "width": 140, "required": true, "entryRow": 0 },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["160m","80m","40m","20m","15m","10m"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW","SSB","USB","LSB"]
    },
    { "id": "rst_rcvd",  "label": "RST R", "type": "text", "width": 50, "required": true, "entryRow": 0 },
    { "id": "year_rcvd", "label": "Yr R",  "type": "text", "width": 45, "required": true, "entryRow": 0, "validator": "numeric" },
    { "id": "rst_sent",  "label": "RST S", "type": "text", "width": 50, "required": true, "entryRow": 1 },
    { "id": "year_sent", "label": "Yr S",  "type": "text", "width": 45, "required": false, "entryRow": 1, "persistent": true, "validator": "numeric" }
  ],

  "scoringRules": {
    "pointsPerQso": 1,
    "scoreFormula": "Total QSO points (1 each, §7) × total multipliers. Multiplier (§6) = distinct two-digit licence-year, counted once PER BAND regardless of mode. Same station workable once per band AND mode (§7). Claimed — EUHFC committee re-adjudicates.",
    "allowDupes": false
  },

  "multiplierModel": {
    "field":   "year_rcvd",
    "perBand": true,
    "validValues": []
  },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "statistics",    "title": "Statistics",    "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloSent": ["rst_sent", "year_sent"],
  "cabrilloRcvd": ["rst_rcvd", "year_rcvd"],

  "sections": []
}

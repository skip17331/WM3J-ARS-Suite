{
  "contestId":   "SD_QSO_PARTY",
  "contestName": "South Dakota QSO Party",
  "version":     "1.0.0",

  "exchangeFormat": "SD: RST + SD county. Non-SD US: RST + state. Canada: RST + province. DX: RST + DXCC country. Bands 160-10m + 6m/2m/1.25m/70cm (no WARC). CW/Phone only (NO digital). SD works everyone; non-SD works SD only.",

  "stationClassifier": "callsignRegion",

  "entryFields": [
    { "id": "callsign", "label": "Callsign", "type": "text", "width": 140, "required": true, "entryRow": 0 },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["160m","80m","40m","20m","15m","10m","6m","2m","1.25m","70cm"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW","SSB","USB","LSB","FM"]
    },
    { "id": "rst_rcvd", "label": "RST R", "type": "text", "width": 50, "required": true, "entryRow": 0 },
    { "id": "state_prov_rcvd", "label": "Co/St R", "type": "text", "width": 90, "required": true, "entryRow": 0 },
    { "id": "rst_sent", "label": "RST S", "type": "text", "width": 50, "required": true, "entryRow": 1 },
    { "id": "state_prov_sent", "label": "My Co/St", "type": "text", "width": 90, "required": false, "entryRow": 1, "persistent": true }
  ],

  "scoringRules": {
    "pointsPerQso": 1,
    "multiplierType": "qso_party",
    "scoreFormula": "(Σ QSO pts × Σ mults, counted ONCE) + bonus. Pts: Phone 1, CW 2. SD entrant mult = SD counties + each US state + each Canadian province + each DXCC country (SD county counted once). Non-SD entrant mult = SD counties only. SD works everyone; non-SD scores SD contacts only (non-SD↔non-SD no credit). SD mobile/rover county-change = new QSO + new county; county-line = separate logged QSOs. W0OJY (sponsoring club) = one-time +100 bonus (additional W0OJY contacts are regular QSOs). Worked once per mode per band. Claimed/running — the SDQP committee re-adjudicates. NOT applied (category): power/operator categories.",
    "allowDupes": false,
    "qsoParty": {
      "stateName": "South Dakota",
      "stateAbbr": "SD",
      "countyByExclusion": true,
      "pointsByModeClass": { "PH": 1, "CW": 2 },
      "multScope": "once",
      "inStateCountsCounties": true,
      "inStateOwnStateMult": false,
      "inStateSelfStateMult": false,
      "inStateCountsStates": true,
      "inStateCountsDxccEach": true,
      "inStateNoDxMult": false,
      "bonusStationsOnce": { "W0OJY": 100 },
      "ft8GridDivisor": 0,
      "outStateGridCap": 0
    }
  },

  "multiplierModel": { "field": "state_prov_rcvd", "perBand": false, "validValues": [] },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "worked_mults",  "title": "SD Counties / Mults", "config": {} },
    { "paneIndex": 3, "paneType": "statistics",    "title": "Statistics", "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloMapping": {
    "callsign":        "rcvd_callsign",
    "rst_sent":        "sent_rst",
    "rst_rcvd":        "rcvd_rst",
    "state_prov_sent": "sent_exchange",
    "state_prov_rcvd": "rcvd_exchange"
  },

  "sections": []
}

{
  "contestId":   "NM_QSO_PARTY",
  "contestName": "New Mexico QSO Party",
  "version":     "1.0.0",

  "exchangeFormat": "NM: RS(T) + NM county (3-letter). Non-NM: RS(T) + state/province/DXCC. AK/HI = state; DC = MD; US/Canada not DX. 160-10m + 6/2m. NM works everyone; non-NM works NM only.",

  "stationClassifier": "callsignRegion",

  "entryFields": [
    { "id": "callsign", "label": "Callsign", "type": "text", "width": 140, "required": true, "entryRow": 0 },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["160m","80m","40m","20m","15m","10m","6m","2m"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW","SSB","USB","LSB","RTTY","PSK31","Digital"]
    },
    { "id": "rst_rcvd", "label": "RST R", "type": "text", "width": 50, "required": false, "entryRow": 0 },
    { "id": "state_prov_rcvd", "label": "Co/St R", "type": "text", "width": 90, "required": true, "entryRow": 0 },
    { "id": "rst_sent", "label": "RST S", "type": "text", "width": 50, "required": false, "entryRow": 1 },
    { "id": "state_prov_sent", "label": "My Co/St", "type": "text", "width": 90, "required": false, "entryRow": 1, "persistent": true }
  ],

  "scoringRules": {
    "pointsPerQso": 1,
    "multiplierType": "qso_party",
    "scoreFormula": "(Σ QSO pts × power-mult × Σ mults) + W1AW/5 one-time +250 (post-multiply). Pts: Phone 1, CW/Digital 2. Mults counted ONCE (any mode/band): NM entrant = NM counties + states + CA prov + each DXCC; non-NM entrant = NM counties (33). Power ×5/×2/×1 (QRP/Low/High) and NM mobile +5000/county@≥15 are OFF-LOG/claimed (entrant category / self-report). Claimed — NMQP organizers re-adjudicate.",
    "allowDupes": false,
    "qsoParty": {
      "stateName": "New Mexico",
      "stateAbbr": "NM",
      "inStateCounties": ["BER","CAT","CHA","CIB","COL","CUR","DEB","DON","EDD","GRA","GUA","HAR","HID","LEA","LIN","LOS","LUN","MCK","MOR","OTE","QUA","RIO","ROO","SJU","SMI","SAN","SFE","SIE","SOC","TAO","TOR","UNI","VAL"],
      "pointsByModeClass": { "PH": 1, "CW": 2, "RY": 2, "DG": 2 },
      "multScope": "once",
      "inStateCountsStates": true,
      "inStateCountsDxccEach": true,
      "inStateCountsCounties": true,
      "inStateNoDxMult": false,
      "mergeRttyDigital": true,
      "ft8GridDivisor": 0,
      "outStateGridCap": 0,
      "bonusStationsOnce": { "W1AW": 250 }
    }
  },

  "multiplierModel": { "field": "state_prov_rcvd", "perBand": false, "validValues": [] },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "worked_mults",  "title": "NM Counties / Mults", "config": {} },
    { "paneIndex": 3, "paneType": "statistics",    "title": "Statistics", "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloMapping": {
    "callsign":        "rcvd_callsign",
    "rst_sent":        "sent_rst",
    "rst_rcvd":        "rcvd_rst",
    "state_prov_sent": "sent_exchange",
    "state_prov_rcvd": "rcvd_exchange"
  },

  "sections": []
}

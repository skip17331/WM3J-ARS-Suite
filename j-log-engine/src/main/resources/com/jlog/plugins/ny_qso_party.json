{
  "contestId":   "NY_QSO_PARTY",
  "contestName": "New York QSO Party",
  "version":     "1.2.0",

  "exchangeFormat": "NY: RST + 3-letter NY county. Non-NY US: RST + state. Canada: RST + province. DX: RST + 'DX'. Bands: all FCC allocated except 30/17/12m. Phone/CW/RTTY-digital (all digital = one mode). NY works everyone; non-NY works NY only.",

  "stationClassifier": "callsignRegion",

  "entryFields": [
    { "id": "callsign", "label": "Callsign", "type": "text", "width": 140, "required": true, "entryRow": 0 },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["160m","80m","40m","20m","15m","10m","6m","2m","1.25m","70cm"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW","SSB","USB","LSB","FM","AM","RTTY","PSK31","Digital"]
    },
    { "id": "rst_rcvd", "label": "RST R", "type": "text", "width": 50, "required": true, "entryRow": 0 },
    { "id": "state_prov_rcvd", "label": "Co/St R", "type": "text", "width": 90, "required": true, "entryRow": 0 },
    { "id": "rst_sent", "label": "RST S", "type": "text", "width": 50, "required": true, "entryRow": 1 },
    { "id": "state_prov_sent", "label": "My Co/St", "type": "text", "width": 90, "required": false, "entryRow": 1, "persistent": true }
  ],

  "multiplierList": "/com/jlog/counties/ny.json",

  "scoringRules": {
    "pointsPerQso": 1,
    "multiplierType": "qso_party",
    "scoreFormula": "Σ QSO pts × Σ mults (counted ONCE, not per band/mode). Pts: Phone 1/band, CW 2/band, RTTY/digital 3/band (all digital = one mode; once per band per mode = 3 max/station/band). NY entrant mult = 62 NY counties + each US state (incl NY via the first NY county logged) + 13 Canadian provinces = 125 max; DX = QSO points only (no mult). Non-NY entrant mult = 62 NY counties. NY works everyone; non-NY scores NY contacts only (non-NY↔non-NY no credit). NY mobile/portable county-change = new QSO + new county; county-line = 2 logged QSOs. Claimed/running — the NYQP committee re-adjudicates. NOT applied (category): power/operator/overlay (Rookie/Youth/YL/School) categories. Only digital modes natively supporting the NYQP exchange are valid (FT8/FT4 excluded).",
    "allowDupes": false,
    "qsoParty": {
      "stateName": "New York",
      "stateAbbr": "NY",
      "countyByExclusion": true,
      "pointsByModeClass": { "PH": 1, "CW": 2, "DG": 3 },
      "multScope": "once",
      "inStateCountsCounties": true,
      "inStateOwnStateMult": false,
      "inStateSelfStateMult": true,
      "inStateCountsStates": true,
      "inStateCountsDxccEach": false,
      "inStateNoDxMult": true,
      "mergeRttyDigital": true,
      "ft8GridDivisor": 0,
      "outStateGridCap": 0
    }
  },

  "multiplierModel": { "field": "state_prov_rcvd", "perBand": false, "validValues": [] },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "worked_mults",  "title": "NY Counties / Mults", "config": {} },
    { "paneIndex": 3, "paneType": "statistics",    "title": "Statistics", "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloSent": ["rst_sent", "state_prov_sent"],
  "cabrilloRcvd": ["rst_rcvd", "state_prov_rcvd"],

  "sections": []
}

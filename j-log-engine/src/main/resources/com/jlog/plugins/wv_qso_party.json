{
  "contestId":   "WV_QSO_PARTY",
  "contestName": "West Virginia QSO Party",
  "version":     "1.0.0",

  "exchangeFormat": "WV: RST + WV county. Non-WV US: RST + state (DC→MD). Canada: RST + province. DX: RST + DXCC country prefix. Bands 80-10m (no WARC). CW/SSB/Digital (digital non-CW = one class). WV works everyone; non-WV works WV only.",

  "stationClassifier": "callsignRegion",

  "entryFields": [
    { "id": "callsign", "label": "Callsign", "type": "text", "width": 140, "required": true, "entryRow": 0 },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["80m","40m","20m","15m","10m"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW","SSB","USB","LSB","RTTY","PSK31","FT8","Digital"]
    },
    { "id": "rst_rcvd", "label": "RST R", "type": "text", "width": 50, "required": true, "entryRow": 0 },
    { "id": "state_prov_rcvd", "label": "Co/St R", "type": "text", "width": 90, "required": true, "entryRow": 0 },
    { "id": "rst_sent", "label": "RST S", "type": "text", "width": 50, "required": true, "entryRow": 1 },
    { "id": "state_prov_sent", "label": "My Co/St", "type": "text", "width": 90, "required": false, "entryRow": 1, "persistent": true }
  ],

  "scoringRules": {
    "pointsPerQso": 1,
    "multiplierType": "qso_party",
    "scoreFormula": "Σ QSO pts × Σ mults (counted ONCE PER CONTEST) + bonuses. Pts: Phone 1, CW & Digital 2 (all non-CW digital = one class). WV entrant mult = WV counties (55, from WV stations) + each US state (50, WV counts as a state, DC→MD) + Canadian provinces (13) + each DXCC entity (USA/AK/HI/Canada excluded). Non-WV entrant mult = WV counties (55). WV works everyone; non-WV scores WV contacts only. Mobiles county-change = new QSO + new county; county-line = 2 QSO/2 mult. Bonus station W8WVA = +100 once per band & mode (post-multiply). Claimed/running — the WVQP committee re-adjudicates. NOT applied (off-log/self): WV-mobile +100 per WV county activated (entrant-self).",
    "allowDupes": false,
    "qsoParty": {
      "stateName": "West Virginia",
      "stateAbbr": "WV",
      "countyByExclusion": true,
      "pointsByModeClass": { "PH": 1, "CW": 2, "DG": 2 },
      "multScope": "once",
      "inStateCountsCounties": true,
      "inStateOwnStateMult": false,
      "inStateSelfStateMult": true,
      "inStateCountsStates": true,
      "inStateCountsDxccEach": true,
      "inStateNoDxMult": false,
      "mergeRttyDigital": true,
      "bonusStations": { "W8WVA": 100 },
      "ft8GridDivisor": 0,
      "outStateGridCap": 0
    }
  },

  "multiplierModel": { "field": "state_prov_rcvd", "perBand": false, "validValues": [] },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "worked_mults",  "title": "WV Counties / Mults", "config": {} },
    { "paneIndex": 3, "paneType": "statistics",    "title": "Statistics", "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloSent": ["rst_sent", "state_prov_sent"],
  "cabrilloRcvd": ["rst_rcvd", "state_prov_rcvd"],

  "sections": []
}

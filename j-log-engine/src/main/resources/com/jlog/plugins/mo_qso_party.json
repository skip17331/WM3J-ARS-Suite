{
  "contestId":   "MO_QSO_PARTY",
  "contestName": "Missouri QSO Party",
  "version":     "1.0.0",

  "exchangeFormat": "MO: RS(T) + county (3-letter, Table 1). Non-MO: RS(T) + state/province. DX: RS(T) + 'DX'. 160-10m + 6/2/1.25m/70cm. No FT8/FT4. MO works everyone; non-MO works MO only.",

  "stationClassifier": "callsignRegion",

  "entryFields": [
    { "id": "callsign", "label": "Callsign", "type": "text", "width": 140, "required": true, "entryRow": 0 },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["160m","80m","40m","20m","15m","10m","6m","2m","1.25m","70cm"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW","SSB","USB","LSB","RTTY","PSK31","Olivia","Digital"]
    },
    { "id": "rst_rcvd", "label": "RST R", "type": "text", "width": 50, "required": false, "entryRow": 0 },
    { "id": "state_prov_rcvd", "label": "Co/St R", "type": "text", "width": 90, "required": true, "entryRow": 0 },
    { "id": "rst_sent", "label": "RST S", "type": "text", "width": 50, "required": false, "entryRow": 1 },
    { "id": "state_prov_sent", "label": "My Co/St", "type": "text", "width": 90, "required": false, "entryRow": 1, "persistent": true }
  ],

  "scoringRules": {
    "pointsPerQso": 1,
    "multiplierType": "qso_party",
    "scoreFormula": "(Σ QSO pts × Σ mults) + bonus. Pts: Phone 1, CW/Digital 2. Mults counted ONCE: MO entrant = MO counties + 49 states + 13 CA prov + 1 (if ≥1 DX worked); non-MO entrant = MO counties only. W0MA & K0GQ = one-time +100 each (post-multiply). Also applied (2026 rules): +100 for submitting the Cabrillo log electronically; +1 per QSO on 40 / 80 m between 1400 and 2000 UTC Saturday and Sunday (at most +250, added after the multiply); a mobile or portable entry with ≥50 valid QSOs from a county gets that county's multiplier (CATEGORY-STATION MOBILE or PORTABLE, from the sent county logged on each QSO); each station is worked once per mode per band per MO county, so a mobile re-works everyone from each new county. Claimed — BEARS-St.Louis re-adjudicates.",
    "allowDupes": false,
    "qsoParty": {
      "electronicLogBonus": 100,
      "timeWindowBonus": {"bands": ["40m", "80m"], "windows": ["SAT 14:00-20:00", "SUN 14:00-20:00"], "pointsPerQso": 1, "cap": 250},
      "activationBonus": {"minQsos": 50, "asMultiplier": true, "stations": ["MOBILE", "PORTABLE"]},
      "ownCountyDupe": true,
      "stateName": "Missouri",
      "stateAbbr": "MO",
      "countyCodeLen": 3,
      "pointsByModeClass": { "PH": 1, "CW": 2, "DG": 2 },
      "multScope": "once",
      "inStateCountsStates": true,
      "inStateCountsDxccEach": false,
      "inStateCountsCounties": true,
      "inStateNoDxMult": false,
      "mergeRttyDigital": true,
      "ft8GridDivisor": 0,
      "outStateGridCap": 0,
      "bonusStationsOnce": { "W0MA": 100, "K0GQ": 100 }
    }
  },

  "multiplierModel": { "field": "state_prov_rcvd", "perBand": false, "validValues": [] },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "worked_mults",  "title": "MO Counties / Mults", "config": {} },
    { "paneIndex": 3, "paneType": "statistics",    "title": "Statistics", "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloSent": ["rst_sent", "state_prov_sent"],
  "cabrilloRcvd": ["rst_rcvd", "state_prov_rcvd"],

  "sections": [],
  "layout": {
    "fieldOrder": ["callsign", "state_prov_rcvd", "rst_rcvd"],
    "tiles": ["mults", "qsosByBand"],
    "macroSet": "contest",
    "cq": "CQ QP {MYCALL}"
  }
}

{
  "contestId":   "ARRL_DX_SSB_DX",
  "contestName": "ARRL International DX (SSB) — DX",
  "version":     "1.0.0",

  "exchangeFormat": "Send 59 POWER | Rcv 59 STATE  (e.g. send: 59 100  rcv: 59 PA)",

  "entryFields": [
    {
      "id": "callsign", "label": "Callsign", "type": "text",
      "width": 130, "required": true, "entryRow": 0
    },
    {
      "id": "band", "label": "Band", "type": "combo",
      "width": 80, "required": false, "entryRow": 0,
      "persistent": true,
      "options": ["160m","80m","40m","20m","15m","10m"]
    },
    {
      "id": "rst_sent", "label": "RST S", "type": "text",
      "width": 50, "required": false, "entryRow": 1
    },
    {
      "id": "rst_rcvd", "label": "RST R", "type": "text",
      "width": 50, "required": false, "entryRow": 0,
      "persistent": true
    },
    {
      "id": "state_rcvd", "label": "St/Prov", "type": "text",
      "width": 65, "required": true, "entryRow": 0
    },
    {
      "id": "power_sent", "label": "Pwr S", "type": "text",
      "width": 55, "required": false, "entryRow": 1,
      "persistent": true
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 55, "required": false, "entryRow": 1,
      "persistent": true,
      "options": ["SSB","USB","LSB"]
    }
  ],

  "scoringRules": {
    "pointsPerQso": 3,
    "modePoints":   {},
    "multiplierType": "states",
    "scoreFormula": "qsoPoints * stateMults",
    "allowDupes": false
  },

  "multiplierModel": {
    "field":  "state_rcvd",
    "perBand": true,
    "validValues": [
      "CT","ME","MA","NH","RI","VT",
      "NJ","NY",
      "DC","DE","MD","PA",
      "AL","FL","GA","KY","NC","SC","TN","VA",
      "AR","LA","MS","NM","OK","TX",
      "CA",
      "AZ","ID","MT","NV","OR","UT","WA","WY",
      "MI","OH","WV",
      "IL","IN","WI",
      "CO","IA","KS","MN","MO","ND","NE","SD",
      "AK","HI",
      "AB","BC","MB","NB","NL","NS","NT","NU","ON","PE","QC","SK","YT"
    ]
  },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "dupe_checker", "title": "Dupe Checker", "config": {} },
    { "paneIndex": 2, "paneType": "statistics",   "title": "Statistics",   "config": {} },
    {
      "paneIndex": 3,
      "paneType":  "section_tracker",
      "title":     "States / Prov Worked",
      "config": {
        "zoneGroups": [
          { "name": "W1", "sections": ["CT","ME","MA","NH","RI","VT"] },
          { "name": "W2", "sections": ["NJ","NY"] },
          { "name": "W3", "sections": ["DC","DE","MD","PA"] },
          { "name": "W4", "sections": ["AL","FL","GA","KY","NC","SC","TN","VA"] },
          { "name": "W5", "sections": ["AR","LA","MS","NM","OK","TX"] },
          { "name": "W6", "sections": ["CA"] },
          { "name": "W7", "sections": ["AZ","ID","MT","NV","OR","UT","WA","WY"] },
          { "name": "W8", "sections": ["MI","OH","WV"] },
          { "name": "W9", "sections": ["IL","IN","WI"] },
          { "name": "W0", "sections": ["CO","IA","KS","MN","MO","ND","NE","SD"] },
          { "name": "AK/HI", "sections": ["AK","HI"] },
          { "name": "VE",  "sections": ["AB","BC","MB","NB","NL","NS","NT","NU","ON","PE","QC","SK","YT"] }
        ]
      }
    }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour","states_worked"],

  "cabrilloMapping": {
    "rst_sent":   "sent_1_rst",
    "field2":     "sent_2_power",
    "rst_rcvd":   "rcvd_1_rst",
    "field1":     "rcvd_2_state"
  },

  "sections": [
    "CT","ME","MA","NH","RI","VT",
    "NJ","NY",
    "DC","DE","MD","PA",
    "AL","FL","GA","KY","NC","SC","TN","VA",
    "AR","LA","MS","NM","OK","TX",
    "CA",
    "AZ","ID","MT","NV","OR","UT","WA","WY",
    "MI","OH","WV",
    "IL","IN","WI",
    "CO","IA","KS","MN","MO","ND","NE","SD",
    "AK","HI",
    "AB","BC","MB","NB","NL","NS","NT","NU","ON","PE","QC","SK","YT"
  ]
}

{
  "contestId":   "CA_QSO_PARTY",
  "contestName": "California QSO Party (CQP)",
  "version":     "1.2.0",

  "exchangeFormat": "CA: serial + 4-letter CA county. Non-CA: serial + 2-letter state/Canadian province/territory or 'DX'. Bands 160-10m. CW/Phone only. CA works everyone; non-CA works CA only (non-CA↔non-CA no QSO credit).",

  "stationClassifier": "callsignRegion",

  "entryFields": [
    { "id": "callsign", "label": "Callsign", "type": "text", "width": 140, "required": true, "entryRow": 0 },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["160m","80m","40m","20m","15m","10m"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW","SSB","USB","LSB"]
    },
    { "id": "serial_rcvd", "label": "# R", "type": "text", "width": 60, "required": false, "entryRow": 0 },
    { "id": "state_prov_rcvd", "label": "Co/St R", "type": "text", "width": 90, "required": true, "entryRow": 0 },
    { "id": "serial_sent", "label": "# S", "type": "text", "width": 60, "required": false, "entryRow": 1 },
    { "id": "state_prov_sent", "label": "My Co/St", "type": "text", "width": 90, "required": false, "entryRow": 1, "persistent": true }
  ],

  "multiplierList": "/com/jlog/counties/ca.json",

  "scoringRules": {
    "pointsPerQso": 1,
    "multiplierType": "qso_party",
    "scoreFormula": "Σ QSO pts × Σ SCORED mults (counted ONCE, not per band/mode; CAPPED at 58). Pts: Phone 2, CW 3. CA entrant mult = 49 other US states + CA itself (the first CA county QSO = the CA multiplier) + 13 Canadian provinces/territories = 63 possible, but only the top 58 are SCORED; DX = QSO credit only (no mult). Non-CA entrant mult = the 58 CA counties. CA works everyone; non-CA scores CA contacts only (non-CA↔non-CA no QSO credit). CA mobile county/state-change = new QSO + new mult. Claimed/running — the NCCC CQP committee re-adjudicates. NOT applied (category): power/operator/expedition categories.",
    "allowDupes": false,
    "qsoParty": {
      "stateName": "California",
      "stateAbbr": "CA",
      "countyByExclusion": true,
      "pointsByModeClass": { "PH": 2, "CW": 3 },
      "multScope": "once",
      "multCap": 58,
      "inStateCountsCounties": false,
      "inStateOwnStateMult": false,
      "inStateSelfStateMult": true,
      "inStateCountsStates": true,
      "inStateCountsDxccEach": false,
      "inStateNoDxMult": true,
      "ft8GridDivisor": 0,
      "outStateGridCap": 0
    }
  },

  "multiplierModel": { "field": "state_prov_rcvd", "perBand": false, "validValues": [] },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "worked_mults",  "title": "CA Counties / Mults", "config": {} },
    { "paneIndex": 3, "paneType": "statistics",    "title": "Statistics", "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloMapping": {
    "callsign":        "rcvd_callsign",
    "serial_sent":     "sent_serial",
    "serial_rcvd":     "rcvd_serial",
    "state_prov_sent": "sent_exchange",
    "state_prov_rcvd": "rcvd_exchange"
  },

  "sections": []
}

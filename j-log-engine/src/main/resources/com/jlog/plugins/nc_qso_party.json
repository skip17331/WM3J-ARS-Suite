{
  "contestId":   "NC_QSO_PARTY",
  "contestName": "North Carolina QSO Party",
  "version":     "1.1.0",

  "exchangeFormat": "NC: call + NC county (3-letter). Non-NC: call + state/province or 'DX'. Signal report optional. 80-2m (no 160/WARC). NC works everyone; non-NC works NC only. FT8/FT4 are a SEPARATE Weak Signal Showcase — not in this log.",

  "stationClassifier": "callsignRegion",

  "entryFields": [
    { "id": "callsign", "label": "Callsign", "type": "text", "width": 140, "required": true, "entryRow": 0 },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["80m","40m","20m","15m","10m","6m","2m"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW","SSB","USB","LSB","AM","FM","RTTY","PSK31","Digital"]
    },
    { "id": "rst_rcvd", "label": "RST R", "type": "text", "width": 50, "required": false, "entryRow": 0 },
    { "id": "state_prov_rcvd", "label": "Co/St R", "type": "text", "width": 90, "required": true, "entryRow": 0 },
    { "id": "rst_sent", "label": "RST S", "type": "text", "width": 50, "required": false, "entryRow": 1 },
    { "id": "state_prov_sent", "label": "My Co/St", "type": "text", "width": 90, "required": false, "entryRow": 1, "persistent": true }
  ],

  "multiplierList": "/com/jlog/counties/nc.json",

  "scoringRules": {
    "pointsPerQso": 2,
    "multiplierType": "qso_party",
    "scoreFormula": "Final = (Σ QSO pts + rare-county bonus QSO pts) × Σ mults, + sweep bonus after the multiply. Pts: Phone 2, CW 3, Digital 5 (FT8/4 excluded — separate Showcase). A QSO with a 'Rarest of NC' county scores ×10 (20/30/50). Mults counted ONCE across all bands/modes: NC entrant = 100 NC counties + 49 states + DC + 13 CA prov/terr + 1 DX (164); non-NC entrant = NC counties only. ≥1 QSO in 5 Rarest counties = +500 post-multiply (sweep). Mobile/county-line = new QSO per county. Claimed — NCQP committee re-adjudicates.",
    "allowDupes": false,
    "qsoParty": {
      "stateName": "North Carolina",
      "stateAbbr": "NC",
      "countyCodeLen": 3,
      "pointsByModeClass": { "PH": 2, "CW": 3, "DG": 5 },
      "multScope": "once",
      "inStateCountsStates": true,
      "inStateCountsDxccEach": false,
      "inStateCountsCounties": true,
      "inStateNoDxMult": false,
      "mergeRttyDigital": true,
      "ft8GridDivisor": 0,
      "outStateGridCap": 0,
      "rareCounties": ["CAB","GRM","VAN","MAC","DAV","CUR","PAM","ALL","PER","CAS"],
      "rareQsoMultiplier": 10,
      "sweepBonusPoints": 500,
      "sweepBonusThreshold": 5
    }
  },

  "multiplierModel": { "field": "state_prov_rcvd", "perBand": false, "validValues": [] },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "worked_mults",  "title": "NC Counties / Mults", "config": {} },
    { "paneIndex": 3, "paneType": "statistics",    "title": "Statistics", "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloSent": ["rst_sent", "state_prov_sent"],
  "cabrilloRcvd": ["rst_rcvd", "state_prov_rcvd"],

  "sections": []
}

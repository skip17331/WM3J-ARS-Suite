{
  "contestId":   "OK_QSO_PARTY",
  "contestName": "Oklahoma QSO Party",
  "version":     "1.0.0",

  "exchangeFormat": "OK: RS(T) + county (3-letter). W/VE incl KH6/KL7: RS(T) + state/province. DX incl KH2/KP4: RS(T) + DXCC prefix. 80-2m (no 160/WARC). No FT8/FT4. OK works everyone; non-OK works OK only.",

  "stationClassifier": "callsignRegion",

  "entryFields": [
    { "id": "callsign", "label": "Callsign", "type": "text", "width": 140, "required": true, "entryRow": 0 },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["80m","40m","20m","15m","10m","6m","2m"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW","SSB","USB","LSB","RTTY","PSK31","Digital"]
    },
    { "id": "rst_rcvd", "label": "RST R", "type": "text", "width": 50, "required": true, "entryRow": 0 },
    { "id": "state_prov_rcvd", "label": "Co/St R", "type": "text", "width": 90, "required": true, "entryRow": 0 },
    { "id": "rst_sent", "label": "RST S", "type": "text", "width": 50, "required": true, "entryRow": 1 },
    { "id": "state_prov_sent", "label": "My Co/St", "type": "text", "width": 90, "required": false, "entryRow": 1, "persistent": true }
  ],

  "scoringRules": {
    "pointsPerQso": 2,
    "multiplierType": "qso_party",
    "scoreFormula": "Total = Σ QSO pts × Σ mults. Pts: Phone 2, CW 3, Digital 3 (no FT8/4); workable per band AND mode. OK entrant: works everyone; mults = 77 OK counties + 50 states (DC=MD) + 13 CA prov/terr + each DXCC (excl US/CA/KH6/KL7), counted ONCE across bands/modes. Non-OK entrant: works OK only; mult = 77 OK counties. Mobile county-change/county-line = new QSO per county. OK-mobile +500/county@≥10 QSOs = off-log/claimed (category-dependent). Claimed — OKQP committee re-adjudicates.",
    "allowDupes": false,
    "qsoParty": {
      "stateName": "Oklahoma",
      "stateAbbr": "OK",
      "countyCodeLen": 3,
      "pointsByModeClass": { "PH": 2, "CW": 3, "DG": 3 },
      "multScope": "once",
      "inStateCountsStates": true,
      "inStateCountsDxccEach": true,
      "inStateCountsCounties": true,
      "inStateNoDxMult": false,
      "mergeRttyDigital": true,
      "ft8GridDivisor": 0,
      "outStateGridCap": 0
    }
  },

  "multiplierModel": { "field": "state_prov_rcvd", "perBand": false, "validValues": [] },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "worked_mults",  "title": "OK Counties / Mults", "config": {} },
    { "paneIndex": 3, "paneType": "statistics",    "title": "Statistics", "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloSent": ["rst_sent", "state_prov_sent"],
  "cabrilloRcvd": ["rst_rcvd", "state_prov_rcvd"],

  "sections": []
}

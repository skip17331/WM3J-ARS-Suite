      "title": "Worked Mults (counties/states)",
      "config": {}
    },
    {
      "paneIndex": 3,
      "paneType": "statistics",
      "title": "Statistics",
      "config": {}
    }
  ],
  "statistics": [
    "qso_count",
    "total_score",
    "multipliers",
    "qso_per_hour"
  ],
  "cabrilloSent": ["rst_sent", "state_prov_sent"],
  "cabrilloRcvd": ["rst_rcvd", "serial_rcvd", "state_prov_rcvd"],
  "sections": []
}

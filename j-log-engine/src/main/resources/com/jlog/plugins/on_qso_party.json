{
  "contestId": "ON_QSO_PARTY",
  "contestName": "Ontario QSO Party",
  "version": "1.1.0",
  "exchangeFormat": "CA: serial + county (e.g. 001 ALAM)   Other: serial + state/prov/DX (e.g. 001 PA)",
  "autoFillDxccPrefix": true,
  "entryFields": [
    {
      "id": "callsign",
      "label": "Callsign",
      "type": "text",
      "width": 140,
      "required": true,
      "entryRow": 0
    },
    {
      "id": "band",
      "label": "Band",
      "type": "text",
      "width": 70,
      "required": true,
      "entryRow": 0,
      "persistent": true,
      "options": [
        "160m",
        "80m",
        "40m",
        "20m",
        "15m",
        "10m",
        "6m",
        "2m"
      ]
    },
    {
      "id": "mode",
      "label": "Mode",
      "type": "text",
      "width": 70,
      "required": true,
      "entryRow": 0,
      "persistent": true,
      "options": [
        "CW",
        "SSB",
        "USB",
        "LSB",
        "FM",
        "RTTY",
        "PSK31",
        "FT8",
        "Digital"
      ]
    },
    {
      "id": "rst_rcvd",
      "label": "RST R",
      "type": "text",
      "width": 50,
      "required": false,
      "entryRow": 0
    },
    {
      "id": "serial_rcvd",
      "label": "# R",
      "type": "text",
      "width": 60,
      "required": true,
      "entryRow": 0,
      "validator": "numeric"
    },
    {
      "id": "state_prov_rcvd",
      "label": "QTH R",
      "type": "text",
      "width": 90,
      "required": true,
      "entryRow": 0
    },
    {
      "id": "rst_sent",
      "label": "RST S",
      "type": "text",
      "width": 50,
      "required": false,
      "entryRow": 1
    },
    {
      "id": "state_prov_sent",
      "label": "QTH S",
      "type": "text",
      "width": 90,
      "required": false,
      "entryRow": 1,
      "persistent": true
    }
  ],
  "multiplierList": "/com/jlog/counties/on.json",
  "scoringRules": {
    "pointsPerQso": 1,
    "multiplierType": "qso_party",
    "scoreFormula": "\u03a3 QSO pts \u00d7 \u03a3 mults (once overall). In-state entrant: own counties + W/VE states/provinces + 1 DX; out-of-state entrant: in-state counties only. Mobile/rover re-worked from a new county = new QSO. Claimed/standard \u2014 sponsor re-adjudicates (per-contest official-rules pass still pending).",
    "allowDupes": false,
    "qsoParty": {
      "stateName": "Ontario",
      "stateAbbr": "ON",
      "pointsByModeClass": {
        "PH": 1,
        "CW": 2,
        "RY": 2,
        "DG": 2
      },
      "multScope": "once",
      "inStateCountsStates": true,
      "inStateCountsDxccEach": false,
      "inStateCountsCounties": true,
      "ft8GridDivisor": 0,
      "outStateGridCap": 0
    }
  },
  "multiplierModel": {
    "field": "state_prov_rcvd",
    "perBand": false,
    "validValues": []
  },
  "row2Panes": [
    {
      "paneIndex": 1,
      "paneType": "worked_before",
      "title": "Worked Before",
      "config": {}
    },
    {
      "paneIndex": 2,

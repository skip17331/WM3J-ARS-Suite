  "multiplierList": "/com/jlog/counties/on.json",
  "scoringRules": {
    "pointsPerQso": 1,
    "multiplierType": "qso_party",
    "scoreFormula": "Total = Σ QSO pts × Σ mults, mults counted once PER BAND. Pts: phone 2, CW 2; 10 for VA3CCO, VE3CCO, VE3ODX, VA3RAC, VE3RHQ. Ontario entrant: Ontario counties + Canadian provinces/territories + US states (+DC) + each DXCC country; non-Ontario entrant: Ontario counties only. Not scored: the mobile/rover bonus (300 per Ontario area activated with 3+ contacts) — add it by hand. Claimed — CCO re-adjudicates.",
    "allowDupes": false,
    "qsoParty": {
      "stateName": "Ontario",
      "stateAbbr": "ON",
      "countyCodeLen": 3,
      "pointsByModeClass": {
        "PH": 2,
        "CW": 2,
        "RY": 2,
        "DG": 2
      },
      "multScope": "per_band",
      "inStateCountsStates": true,
      "inStateCountsDxccEach": true,
      "inStateCountsCounties": true,
      "qsoPointCalls": { "VA3CCO": 10, "VE3CCO": 10, "VE3ODX": 10, "VA3RAC": 10, "VE3RHQ": 10 },
      "ft8GridDivisor": 0,
      "outStateGridCap": 0
    }
  },
  "multiplierModel": {

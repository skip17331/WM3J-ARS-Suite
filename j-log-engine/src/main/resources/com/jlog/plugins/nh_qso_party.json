{
  "contestId":   "NH_QSO_PARTY",
  "contestName": "New Hampshire QSO Party",
  "version":     "1.0.0",

  "exchangeFormat": "NH: RST + NH county (BEL/CAR/CHE/COO/GRA/HIL/MER/ROC/STR/SUL). Non-NH W/VE: RST + state/province. DX: RST + 'DX'. Bands 80-10m (no WARC). CW/Phone/Digital. NH works everyone; non-NH works NH only.",

  "stationClassifier": "callsignRegion",

  "entryFields": [
    { "id": "callsign", "label": "Callsign", "type": "text", "width": 140, "required": true, "entryRow": 0 },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["80m","40m","20m","15m","10m"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW","SSB","USB","LSB","RTTY","PSK31","FT8","Digital"]
    },
    { "id": "rst_rcvd", "label": "RST R", "type": "text", "width": 50, "required": true, "entryRow": 0 },
    { "id": "state_prov_rcvd", "label": "Co/St R", "type": "text", "width": 90, "required": true, "entryRow": 0 },
    { "id": "rst_sent", "label": "RST S", "type": "text", "width": 50, "required": true, "entryRow": 1 },
    { "id": "state_prov_sent", "label": "My Co/St", "type": "text", "width": 90, "required": false, "entryRow": 1, "persistent": true }
  ],

  "multiplierList": "/com/jlog/counties/nh.json",

  "scoringRules": {
    "pointsPerQso": 1,
    "multiplierType": "qso_party",
    "scoreFormula": "Σ QSO pts × Σ mults. Pts: Phone 1, CW & Digital 2. NH entrant mult = each NH county + each US state + each Canadian province + up to 10 DXCC, counted ONCE (not per band/mode). Non-NH entrant mult = each NH county ONCE PER BAND (max 50 = 10 counties × 5 bands). NH works everyone; non-NH scores NH contacts only (non-NH↔non-NH no credit). Worked once per band per mode; mobile/portable county-change = new QSO + new county. Claimed/running — the Port City ARC committee re-adjudicates. NOT enforced (claimed): the DXCC 'up to 10' cap (each DXCC entity counted; over-count only if >10 distinct DX). NOT applied (category): power/operator/POTA categories.",
    "allowDupes": false,
    "qsoParty": {
      "stateName": "New Hampshire",
      "stateAbbr": "NH",
      "countyByExclusion": true,
      "pointsByModeClass": { "PH": 1, "CW": 2, "DG": 2 },
      "multScope": "once",
      "multScopeOut": "per_band",
      "inStateCountsCounties": true,
      "inStateOwnStateMult": false,
      "inStateSelfStateMult": false,
      "inStateCountsStates": true,
      "inStateCountsDxccEach": true,
      "inStateNoDxMult": false,
      "mergeRttyDigital": true,
      "ft8GridDivisor": 0,
      "outStateGridCap": 0
    }
  },

  "multiplierModel": { "field": "state_prov_rcvd", "perBand": false, "validValues": [] },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "worked_mults",  "title": "NH Counties / Mults", "config": {} },
    { "paneIndex": 3, "paneType": "statistics",    "title": "Statistics", "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloSent": ["rst_sent", "state_prov_sent"],
  "cabrilloRcvd": ["rst_rcvd", "state_prov_rcvd"],

  "sections": []
}

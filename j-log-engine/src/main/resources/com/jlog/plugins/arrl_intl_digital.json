{
  "contestId":   "ARRL_INTL_DIGITAL",
  "contestName": "ARRL International Digital Contest",
  "version":     "1.0.0",

  "exchangeFormat": "Both stations send 4-char grid (e.g. FN10, IO91)",

  "entryFields": [
    {
      "id": "callsign", "label": "Callsign", "type": "text",
      "width": 140, "required": true, "entryRow": 0
    },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["160m","80m","40m","20m","15m","10m","6m","2m","70cm"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["FT8","FT4","RTTY","PSK31","PSK63","Digital"]
    },
    {
      "id": "rst_rcvd", "label": "RST R", "type": "text",
      "width": 50, "required": false, "entryRow": 0
    },
    {
      "id": "grid_rcvd", "label": "Grid R", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "validator": "maidenhead"
    },
    {
      "id": "rst_sent", "label": "RST S", "type": "text",
      "width": 50, "required": false, "entryRow": 1
    },
    {
      "id": "grid_sent", "label": "Grid S", "type": "text",
      "width": 70, "required": true, "entryRow": 1,
      "persistent": true,
      "validator": "maidenhead"
    }
  ],

  "scoringRules": {
    "pointsPerQso":  1,
    "modePoints":    {},
    "pointsByBandClass": { "HF": 1, "VHF": 2 },
    "multiplierType": "custom",
    "scoreFormula":  "qsoPoints * multipliers",
    "allowDupes":    false
  },

  "multiplierModel": {
    "field":   "grid_rcvd",
    "perBand": true,
    "validValues": []
  },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "grid_map",      "title": "Worked Grids (per band)", "config": {} },
    { "paneIndex": 3, "paneType": "statistics",    "title": "Statistics", "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloMapping": {
    "callsign":   "rcvd_callsign",
    "rst_sent":   "sent_rst",
    "rst_rcvd":   "rcvd_rst",
    "grid_sent":  "sent_exchange",
    "grid_rcvd":  "rcvd_exchange"
  },

  "sections": []
}

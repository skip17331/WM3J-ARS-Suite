{
  "contestId":   "ME_QSO_PARTY",
  "contestName": "Maine QSO Party",
  "version":     "1.0.0",

  "exchangeFormat": "ME: RST + ME county (16, e.g. CBL). Non-ME US/Canada: RST + state/province (DC→MD; NF & LB separate). DX: RST + 'DX'. Bands 160-10m (no WARC). CW/Phone (SSB/FM/AM). Everyone works everyone — all qualifying QSOs score.",

  "stationClassifier": "callsignRegion",

  "entryFields": [
    { "id": "callsign", "label": "Callsign", "type": "text", "width": 140, "required": true, "entryRow": 0 },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["160m","80m","40m","20m","15m","10m"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW","SSB","USB","LSB","FM","AM"]
    },
    { "id": "rst_rcvd", "label": "RST R", "type": "text", "width": 50, "required": true, "entryRow": 0 },
    { "id": "state_prov_rcvd", "label": "Co/St R", "type": "text", "width": 90, "required": true, "entryRow": 0 },
    { "id": "rst_sent", "label": "RST S", "type": "text", "width": 50, "required": true, "entryRow": 1 },
    { "id": "state_prov_sent", "label": "My Co/St", "type": "text", "width": 90, "required": false, "entryRow": 1, "persistent": true }
  ],

  "multiplierList": "/com/jlog/counties/me.json",

  "scoringRules": {
    "pointsPerQso": 1,
    "multiplierType": "qso_party",
    "scoreFormula": "Σ QSO pts × Σ mults. Every qualifying QSO scores (not just Maine contacts). Pts: a QSO with a Maine station = 2, any other = 1 (same rule for every entrant). Multipliers are the SAME for all participants = Maine counties (16) + US states (50, DC counted as MD) + Canadian provinces (14: NB NS QC ON MB SK AB BC NT NF LB YT PE NU — NF & LB separate) + each DXCC entity. Each multiplier counted once on EACH mode on EACH of the 6 bands (per band+mode). Worked once per mode per band; no cross-mode/band/repeater. Final = total QSO pts (all bands) × total mults (all bands/modes). Claimed/running — the WSSM Maine QSO Party committee re-adjudicates. NOT applied (category): power/operator/mobile categories.",
    "allowDupes": false,
    "qsoParty": {
      "stateName": "Maine",
      "stateAbbr": "ME",
      "countyByExclusion": true,
      "ptsWorkedInState": 2,
      "ptsWorkedOutState": 1,
      "pointsAllQsos": true,
      "multsAllEntrants": true,
      "multScope": "per_band_mode",
      "inStateCountsCounties": true,
      "inStateOwnStateMult": false,
      "inStateSelfStateMult": false,
      "inStateCountsStates": true,
      "inStateCountsDxccEach": true,
      "inStateNoDxMult": false,
      "ft8GridDivisor": 0,
      "outStateGridCap": 0
    }
  },

  "multiplierModel": { "field": "state_prov_rcvd", "perBand": true, "validValues": [] },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "worked_mults",  "title": "ME Counties / Mults", "config": {} },
    { "paneIndex": 3, "paneType": "statistics",    "title": "Statistics", "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloSent": ["rst_sent", "state_prov_sent"],
  "cabrilloRcvd": ["rst_rcvd", "state_prov_rcvd"],

  "sections": []
}

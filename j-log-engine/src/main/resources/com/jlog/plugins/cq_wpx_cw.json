{
  "contestId":   "CQ_WPX_CW",
  "contestName": "CQ Worked All Prefixes (CW)",
  "version":     "1.0.0",

  "exchangeFormat": "RST + serial (e.g. 599 123). Mult = WPX prefix of worked call.",

  "lockedMode":         "CW",
  "autoFillWpxPrefix":  true,

  "entryFields": [
    {
      "id": "callsign", "label": "Callsign", "type": "text",
      "width": 140, "required": true, "entryRow": 0
    },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["160m","80m","40m","20m","15m","10m"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 60, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW"]
    },
    {
      "id": "rst_rcvd", "label": "RST R", "type": "text",
      "width": 50, "required": false, "entryRow": 0
    },
    {
      "id": "serial_rcvd", "label": "# R", "type": "text",
      "width": 60, "required": true, "entryRow": 0,
      "validator": "numeric"
    },
    {
      "id": "prefix_rcvd", "label": "Prefix", "type": "text",
      "width": 70, "required": true, "entryRow": 0
    },
    {
      "id": "rst_sent", "label": "RST S", "type": "text",
      "width": 50, "required": false, "entryRow": 1
    }
  ],

  "scoringRules": {
    "pointsPerQso":  1,
    "modePoints":    {},
    "multiplierType": "custom",
    "scoreFormula":  "qsoPoints * multipliers",
    "allowDupes":    false
  },

  "multiplierModel": {
    "field":   "prefix_rcvd",
    "perBand": false,
    "validValues": []
  },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before",   "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "statistics",      "title": "Statistics", "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour","prefixes_worked"],

  "cabrilloMapping": {
    "callsign":     "rcvd_callsign",
    "rst_sent":     "sent_rst",
    "rst_rcvd":     "rcvd_rst",
    "serial_rcvd":  "rcvd_serial"
  },

  "sections": []
}

{
  "contestId":   "ARRL_RTTY_RU",
  "contestName": "ARRL RTTY Roundup",
  "version":     "1.0.0",

  "exchangeFormat": "Send: 599 STATE  Rcv: 599 STATE/DX  (e.g. send 599 PA, DX stations rcv 599 DX)",

  "entryFields": [
    {
      "id": "callsign", "label": "Callsign", "type": "text",
      "width": 130, "required": true, "entryRow": 0
    },
    {
      "id": "band", "label": "Band", "type": "combo",
      "width": 80, "required": false, "entryRow": 0,
      "persistent": true,
      "options": ["80m","40m","20m","15m","10m"]
    },
    {
      "id": "mode", "label": "Mode", "type": "combo",
      "width": 80, "required": false, "entryRow": 0,
      "persistent": true,
      "options": ["RTTY","PSK31","PSK63","Digital"]
    },
    {
      "id": "rst_sent", "label": "RST S", "type": "text",
      "width": 50, "required": false, "entryRow": 1
    },
    {
      "id": "rst_rcvd", "label": "RST R", "type": "text",
      "width": 50, "required": false, "entryRow": 0,
      "persistent": true
    },
    {
      "id": "exch", "label": "St/Pv/DX", "type": "text",
      "width": 75, "required": true, "entryRow": 0
    },
    {
      "id": "exch_sent", "label": "St/Pv S", "type": "text",
      "width": 65, "required": false, "entryRow": 1,
      "persistent": true
    }
  ],

  "scoringRules": {
    "pointsPerQso": 1,
    "modePoints":   {},
    "multiplierType": "states",
    "scoreFormula": "qsoPoints * multipliers",
    "allowDupes": false
  },

  "multiplierModel": {
    "field":  "exch",
    "perBand": true,
    "validValues": [
      "AL","AK","AZ","AR","CA","CO","CT","DE","FL","GA",
      "HI","ID","IL","IN","IA","KS","KY","LA","ME","MD",
      "MA","MI","MN","MS","MO","MT","NE","NV","NH","NJ",
      "NM","NY","NC","ND","OH","OK","OR","PA","RI","SC",
      "SD","TN","TX","UT","VT","VA","WA","WV","WI","WY",
      "AB","BC","MB","NB","NL","NS","NT","NU","ON","PE","QC","SK","YT",
      "DX"
    ]
  },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "dupe_checker", "title": "Dupe Checker", "config": {} },
    { "paneIndex": 2, "paneType": "statistics",   "title": "Statistics",   "config": {} },
    {
      "paneIndex": 3,
      "paneType":  "section_tracker",
      "title":     "Mults Worked",
      "config": {
        "zoneGroups": [
          { "name": "W1", "sections": ["CT","ME","MA","NH","RI","VT"] },
          { "name": "W2", "sections": ["NJ","NY"] },
          { "name": "W3", "sections": ["DE","MD","PA"] },
          { "name": "W4", "sections": ["AL","FL","GA","KY","NC","SC","TN","VA"] },
          { "name": "W5", "sections": ["AR","LA","MS","NM","OK","TX"] },
          { "name": "W6", "sections": ["CA"] },
          { "name": "W7", "sections": ["AZ","ID","MT","NV","OR","UT","WA","WY"] },
          { "name": "W8", "sections": ["MI","OH","WV"] },
          { "name": "W9", "sections": ["IL","IN","WI"] },
          { "name": "W0", "sections": ["CO","IA","KS","MN","MO","ND","NE","SD"] },
          { "name": "AK/HI", "sections": ["AK","HI"] },
          { "name": "VE", "sections": ["AB","BC","MB","NB","NL","NS","NT","NU","ON","PE","QC","SK","YT"] }
        ]
      }
    }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour","states_worked"],

  "cabrilloMapping": {
    "rst_sent":   "sent_1_rst",
    "field2":     "sent_2_exch",
    "rst_rcvd":   "rcvd_1_rst",
    "field1":     "rcvd_2_exch"
  },

  "sections": [
    "AL","AK","AZ","AR","CA","CO","CT","DE","FL","GA",
    "HI","ID","IL","IN","IA","KS","KY","LA","ME","MD",
    "MA","MI","MN","MS","MO","MT","NE","NV","NH","NJ",
    "NM","NY","NC","ND","OH","OK","OR","PA","RI","SC",
    "SD","TN","TX","UT","VT","VA","WA","WV","WI","WY",
    "AB","BC","MB","NB","NL","NS","NT","NU","ON","PE","QC","SK","YT",
    "DX"
  ]
}

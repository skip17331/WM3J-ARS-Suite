    {
      "id": "name_sent", "constant": true, "label": "Name S", "type": "text",
      "width": 90, "required": false, "entryRow": 1,
      "persistent": true
    },
    {
      "id": "year_sent", "constant": true, "label": "Yr S", "type": "text",
      "width": 45, "required": false, "entryRow": 1,

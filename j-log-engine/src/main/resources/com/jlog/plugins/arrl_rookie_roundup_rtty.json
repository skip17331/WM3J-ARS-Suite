{
  "contestId":   "ARRL_RRU_RTTY",
  "contestName": "ARRL Rookie Roundup (RTTY)",
  "version":     "1.1.0",

  "exchangeFormat": "NAME YY STATE/PROV/XE#/DX  (e.g. JOHN 23 PA, SUE 05 ON, RAMON 96 XE1, TOSHI 75 DX)",


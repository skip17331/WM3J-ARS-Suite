{
  "contestId":   "WAE_CW",
  "contestName": "Worked All Europe DX Contest (CW)",
  "version":     "1.1.0",

  "exchangeFormat": "EU ↔ non-EU only (§5). RST + serial from 001 (log 000 if none). QTCs via the QTC pane.",

  "lockedMode": "CW",

  "entryFields": [
    { "id": "callsign", "label": "Callsign", "type": "text", "width": 140, "required": true, "entryRow": 0 },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0, "persistent": true,
      "options": ["80m","40m","20m","15m","10m"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 60, "required": true, "entryRow": 0, "persistent": true,
      "options": ["CW"]
    },
    { "id": "rst_rcvd",    "label": "RST R", "type": "text", "width": 50, "required": true, "entryRow": 0 },
    { "id": "serial_rcvd", "label": "# R",   "type": "text", "width": 60, "required": true, "entryRow": 0, "validator": "numeric" },
    { "id": "rst_sent",    "label": "RST S", "type": "text", "width": 50, "required": true, "entryRow": 1 }
  ],

  "scoringRules": {
    "pointsPerQso":  1,
    "multiplierType": "wae",
    "scoreFormula":  "(Σ QSOs[1pt] + Σ QTCs[1pt]) × Σband(distinct WAE mult × bandWeight); weight 80m×4 40m×3 20/15/10m×2 (§6/§8). Claimed/running — WAEDC re-adjudicates.",
    "allowDupes":    false
  },

  "multiplierModel": { "field": "callsign", "perBand": true, "validValues": [] },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "qtc",           "title": "QTC Traffic",   "config": {} },
    { "paneIndex": 3, "paneType": "statistics",    "title": "Statistics",    "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloSent": ["rst_sent", "serial_sent"],
  "cabrilloRcvd": ["rst_rcvd", "serial_rcvd"],

  "sections": []
}

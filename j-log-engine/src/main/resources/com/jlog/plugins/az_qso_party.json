{
  "contestId":   "AZ_QSO_PARTY",
  "contestName": "Arizona QSO Party",
  "version":     "1.0.0",

  "exchangeFormat": "AZ: RST + 3-letter AZ county (15). Non-AZ US: RST + state. Canada: RST + province/territory. DX: RST + DXCC prefix. Bands 160-10m. CW/Phone only. AZ works everyone; non-AZ works AZ only.",

  "stationClassifier": "callsignRegion",

  "entryFields": [
    { "id": "callsign", "label": "Callsign", "type": "text", "width": 140, "required": true, "entryRow": 0 },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["160m","80m","40m","20m","15m","10m"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW","SSB","USB","LSB"]
    },
    { "id": "rst_rcvd", "label": "RST R", "type": "text", "width": 50, "required": true, "entryRow": 0 },
    { "id": "state_prov_rcvd", "label": "Co/St R", "type": "text", "width": 90, "required": true, "entryRow": 0 },
    { "id": "rst_sent", "label": "RST S", "type": "text", "width": 50, "required": true, "entryRow": 1 },
    { "id": "state_prov_sent", "label": "My Co/St", "type": "text", "width": 90, "required": false, "entryRow": 1, "persistent": true }
  ],

  "multiplierList": "/com/jlog/counties/az.json",

  "scoringRules": {
    "pointsPerQso": 1,
    "multiplierType": "qso_party",
    "scoreFormula": "(Σ QSO pts × Σ mults) + bonus. Pts: CW 2, Phone 1. AZ entrant mult = each US state (50) + each Canadian province/territory (13) + each DXCC country, counted again PER MODE. Non-AZ entrant mult = the 15 AZ counties, counted again PER BAND and PER MODE (15×6×2=180 max). AZ works everyone; non-AZ scores AZ contacts only (non-AZ↔non-AZ no credit). Work once per band per mode per AZ county; AZ mobile county-change = new QSO + new mult. K7A one-time +100 bonus (any band/mode). Claimed/running — the AZQP committee re-adjudicates. NOT applied (category): power/operator categories.",
    "allowDupes": false,
    "qsoParty": {
      "stateName": "Arizona",
      "stateAbbr": "AZ",
      "countyByExclusion": true,
      "pointsByModeClass": { "CW": 2, "PH": 1 },
      "multScope": "per_mode",
      "multScopeOut": "per_band_mode",
      "inStateCountsCounties": false,
      "inStateOwnStateMult": false,
      "inStateSelfStateMult": false,
      "inStateCountsStates": true,
      "inStateCountsDxccEach": true,
      "inStateNoDxMult": false,
      "bonusStationsOnce": { "K7A": 100 },
      "ft8GridDivisor": 0,
      "outStateGridCap": 0
    }
  },

  "multiplierModel": { "field": "state_prov_rcvd", "perBand": true, "validValues": [] },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "worked_mults",  "title": "AZ Counties / Mults", "config": {} },
    { "paneIndex": 3, "paneType": "statistics",    "title": "Statistics", "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloMapping": {
    "callsign":        "rcvd_callsign",
    "rst_sent":        "sent_rst",
    "rst_rcvd":        "rcvd_rst",
    "state_prov_sent": "sent_exchange",
    "state_prov_rcvd": "rcvd_exchange"
  },

  "sections": []
}

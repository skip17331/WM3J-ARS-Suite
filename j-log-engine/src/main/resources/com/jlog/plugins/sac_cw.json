{
  "contestId":   "SAC_CW",
  "contestName": "Scandinavian Activity Contest (CW)",
  "version":     "1.1.0",

  "exchangeFormat": "RST + serial from 001 (§6). CW only, 80/40/20/15/10m (no 160m/WARC). Scandinavians work the world; everyone else works Scandinavians only (§3/§7).",

  "lockedMode": "CW",

  "entryFields": [
    { "id": "callsign", "label": "Callsign", "type": "text", "width": 140, "required": true, "entryRow": 0 },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["80m","40m","20m","15m","10m"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 60, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW"]
    },
    { "id": "rst_rcvd",    "label": "RST R", "type": "text", "width": 50, "required": true, "entryRow": 0 },
    { "id": "serial_rcvd", "label": "# R",   "type": "text", "width": 60, "required": true, "entryRow": 0, "validator": "numeric" },
    { "id": "rst_sent",    "label": "RST S", "type": "text", "width": 50, "required": true, "entryRow": 1 }
  ],

  "scoringRules": {
    "pointsPerQso": 1,
    "multiplierType": "sac",
    "scoreFormula": "Σ QSO pts × Σ (DXCC/district) mults per band (§7/§8). Pts §7: Scandinavian entrant — intra-Scand 0, vs EU non-Scand 2, vs DX 3; non-Scandinavian entrant — Scand QSOs only, EU entrant 1/band, DX entrant 3 on 80/40m else 1. Mult §8: Scand entrant = DXCC entities per band; non-Scand entrant = Scandinavian districts (entity + call-area digit) per band. Claimed — the SAC committee re-adjudicates.",
    "allowDupes": false
  },

  "multiplierModel": { "field": "", "perBand": true, "validValues": [] },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "statistics",    "title": "Statistics",    "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloSent": ["rst_sent", "serial_sent"],
  "cabrilloRcvd": ["rst_rcvd", "serial_rcvd"],

  "sections": []
}

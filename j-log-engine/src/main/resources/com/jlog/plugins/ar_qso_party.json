{
  "contestId":   "AR_QSO_PARTY",
  "contestName": "Arkansas QSO Party",
  "version":     "1.0.0",

  "exchangeFormat": "AR: RST + 3-letter AR county. Non-AR US: RST + state. Canada: RST + province. DX: RST + 'DX'. Bands 160-10m + 6m + 2m. CW/Phone/Digital. AR works everyone; non-AR works AR only (non-AR↔non-AR no credit).",

  "stationClassifier": "callsignRegion",

  "entryFields": [
    { "id": "callsign", "label": "Callsign", "type": "text", "width": 140, "required": true, "entryRow": 0 },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["160m","80m","40m","20m","15m","10m","6m","2m"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW","SSB","USB","LSB","FM","RTTY","PSK31","FT8","Digital"]
    },
    { "id": "rst_rcvd", "label": "RST R", "type": "text", "width": 50, "required": true, "entryRow": 0 },
    { "id": "state_prov_rcvd", "label": "Co/St R", "type": "text", "width": 90, "required": true, "entryRow": 0 },
    { "id": "rst_sent", "label": "RST S", "type": "text", "width": 50, "required": true, "entryRow": 1 },
    { "id": "state_prov_sent", "label": "My Co/St", "type": "text", "width": 90, "required": false, "entryRow": 1, "persistent": true }
  ],

  "scoringRules": {
    "pointsPerQso": 1,
    "multiplierType": "qso_party",
    "scoreFormula": "Σ QSO pts × Σ mults (counted ONCE PER CONTEST) + bonuses. 1 pt/QSO any band/mode (Mobile/Portable/Rover claim 2/QSO — off-log category). AR entrant mult = AR counties (75) + US states except AR (49) + Canadian provinces (13) + ONE DX mult. Non-AR entrant mult = AR counties (75). AR works everyone; non-AR scores AR contacts only (non-AR↔non-AR no credit). Mobile/Portable/Rover county-change = new QSO + new county. Bonus station WR5P = +200 per valid QSO, once per band & mode (post-multiply). Claimed/running — the ARQP committee re-adjudicates. NOT applied (off-log/self/category): Mobile/Portable/Rover 2-pt rate (default 1); Rover/Portable +200 per activated AR county (entrant-self); live-stream +500 (proof-based).",
    "allowDupes": false,
    "qsoParty": {
      "stateName": "Arkansas",
      "stateAbbr": "AR",
      "countyByExclusion": true,
      "multScope": "once",
      "inStateCountsCounties": true,
      "inStateOwnStateMult": false,
      "inStateCountsStates": true,
      "inStateCountsDxccEach": false,
      "inStateNoDxMult": false,
      "mergeRttyDigital": true,
      "bonusStations": { "WR5P": 200 },
      "ft8GridDivisor": 0,
      "outStateGridCap": 0
    }
  },

  "multiplierModel": { "field": "state_prov_rcvd", "perBand": false, "validValues": [] },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "worked_mults",  "title": "AR Counties / Mults", "config": {} },
    { "paneIndex": 3, "paneType": "statistics",    "title": "Statistics", "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloSent": ["rst_sent", "state_prov_sent"],
  "cabrilloRcvd": ["rst_rcvd", "state_prov_rcvd"],

  "sections": []
}

{
  "contestId":   "ARRL_FIELD_DAY",
  "contestName": "ARRL Field Day",
  "version":     "1.1.0",

  "exchangeFormat": "Both send CLASS + ARRL/RAC SECTION (e.g. 3A CT, 1D STX, 2F NLI); DX stations send class + DX (e.g. 2A DX)",

  "fieldDayModeDupe": true,

  "entryFields": [
    {
      "id": "callsign", "label": "Callsign", "type": "text",
      "width": 140, "required": true, "entryRow": 0
    },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["160m","80m","40m","20m","15m","10m","6m","2m","1.25m","70cm","33cm","23cm","13cm","9cm","6cm","3cm","SAT"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 80, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW","SSB","USB","LSB","FM","FT8","FT4","RTTY","PSK31","Digital"]
    },
    {
      "id": "class_rcvd", "label": "Class R", "type": "text",
      "width": 60, "required": true, "entryRow": 0,
      "validator": "fd_class"
    },
    {
      "id": "sect_rcvd", "label": "Sect R", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "options": [
        "CT","EMA","ME","NH","RI","VT","WMA",
        "ENY","NLI","NNJ","NNY","SNJ","WNY",
        "DE","EPA","MDC","WPA",
        "AL","GA","KY","NC","NFL","SC","SFL","TN","VA","WCF","PR","VI",
        "AR","LA","MS","NM","NTX","OK","STX","WTX",
        "EB","LAX","ORG","SB","SCV","SDG","SF","SJV","SV","PAC",
        "AK","AZ","EWA","ID","MT","NV","OR","UT","WWA","WY",
        "MI","OH","WV",
        "IL","IN","WI",
        "CO","IA","KS","MN","MO","NE","ND","SD",
        "AB","BC","GH","MB","NB","NL","NS","ONE","ONN","ONS","PE","QC","SK","TER",
        "DX"
      ]
    },
    {
      "id": "class_sent", "constant": true, "label": "Class S", "type": "text",
      "width": 60, "required": false, "entryRow": 1,
      "persistent": true,
      "validator": "fd_class"
    },
    {
      "id": "sect_sent", "constant": true, "label": "Sect S", "type": "text",
      "width": 70, "required": false, "entryRow": 1,
      "persistent": true
    }
  ],

  "scoringRules": {
    "pointsPerQso":  1,
    "modePoints":    { "CW": 2, "FT8": 2, "FT4": 2, "RTTY": 2, "PSK31": 2, "Digital": 2 },
    "multiplierType": "sections",
    "scoreFormula":  "Cockpit shows the Σ QSO-point subtotal (Phone 1, CW/Digital 2 — Rule 7.1). FINAL Field Day score = QSO pts × power-multiplier (1/2/5, Rule 7.2) + bonus points (Rule 7.3); the power multiplier and bonuses are operator-declared on the ARRL summary sheet and ARRL does NOT score from logs (Rule 8.6) — therefore not computed here (flagged off-log). Sections are an informational 'worked' tally, NOT a QSO multiplier.",
    "scoreIsPointsOnly": true,
    "allowDupes":    false
  },

  "multiplierModel": {
    "field":     "sect_rcvd",
    "perBand":   false,
    "validValues": []
  },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "statistics",    "title": "Statistics", "config": {} }
  ],

  "statistics": ["qso_count","total_score","qso_per_hour","sections_worked"],

  "cabrilloSent": ["class_sent", "sect_sent"],
  "cabrilloRcvd": ["class_rcvd", "sect_rcvd"],

  "sections": [
    "CT","EMA","ME","NH","RI","VT","WMA",
    "ENY","NLI","NNJ","NNY","SNJ","WNY",
    "DE","EPA","MDC","WPA",
    "AL","GA","KY","NC","NFL","SC","SFL","TN","VA","WCF","PR","VI",
    "AR","LA","MS","NM","NTX","OK","STX","WTX",
    "EB","LAX","ORG","SB","SCV","SDG","SF","SJV","SV","PAC",
    "AK","AZ","EWA","ID","MT","NV","OR","UT","WWA","WY",
    "MI","OH","WV",
    "IL","IN","WI",
    "CO","IA","KS","MN","MO","NE","ND","SD",
    "AB","BC","GH","MB","NB","NL","NS","ONE","ONN","ONS","PE","QC","SK","TER",
    "DX"
  ]
}

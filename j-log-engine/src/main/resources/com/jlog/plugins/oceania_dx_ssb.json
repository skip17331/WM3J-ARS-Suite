{
  "contestId":   "OCEANIA_DX_SSB",
  "contestName": "Oceania DX Contest (SSB)",
  "version":     "1.1.0",

  "exchangeFormat": "RS + serial from 001 (Rule 8; log 001 if none received). SSB only, 160-10m no WARC. Oceania works the world; non-Oceania works Oceania only (Rule 4).",

  "lockedMode": "SSB",

  "entryFields": [
    { "id": "callsign", "label": "Callsign", "type": "text", "width": 140, "required": true, "entryRow": 0 },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["160m","80m","40m","20m","15m","10m"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 60, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["SSB","USB","LSB"]
    },
    { "id": "rst_rcvd",    "label": "RS R", "type": "text", "width": 50, "required": true, "entryRow": 0 },
    { "id": "serial_rcvd", "label": "# R",  "type": "text", "width": 60, "required": true, "entryRow": 0, "validator": "numeric" },
    { "id": "rst_sent",    "label": "RS S", "type": "text", "width": 50, "required": true, "entryRow": 1 }
  ],

  "scoringRules": {
    "pointsPerQso": 1,
    "multiplierType": "oceania_dx",
    "scoreFormula": "Σ contact pts × Σ prefix mults (Rule 10/11). Pts by band: 160=20, 80=10, 40=5, 20=1, 15=2, 10=3 — Oceania entrant scores every QSO, non-Oceania entrant only QSOs with Oceania stations (non-Oc↔non-Oc = 0, Rule 4b). Mult = distinct WPX prefixes, once per band; non-Oceania entrant counts Oceania prefixes only. Claimed — the OCDX committee re-adjudicates.",
    "allowDupes": false
  },

  "multiplierModel": { "field": "", "perBand": true, "validValues": [] },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "statistics",    "title": "Statistics",    "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloMapping": {
    "callsign":    "rcvd_callsign",
    "rst_sent":    "sent_rst",
    "serial_sent": "sent_serial",
    "rst_rcvd":    "rcvd_rst",
    "serial_rcvd": "rcvd_serial"
  },

  "sections": []
}

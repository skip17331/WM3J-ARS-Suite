{
  "contestId":   "ARI_DX",
  "contestName": "ARI International DX Contest (Italy)",
  "version":     "1.0.0",

  "exchangeFormat": "I: RST + province code (e.g. 599 MI)   DX: RST + serial (e.g. 599 001)",

  "stationClassifier":  "callsignRegion",
  "autoFillDxccPrefix": true,

  "entryFields": [
    { "id": "callsign", "label": "Callsign", "type": "text", "width": 140, "required": true, "entryRow": 0 },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["160m","80m","40m","20m","15m","10m"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW","SSB","USB","LSB","RTTY","PSK31","Digital"]
    },
    { "id": "rst_rcvd", "label": "RST R", "type": "text", "width": 50, "required": false, "entryRow": 0 },
    {
      "id": "state_prov_rcvd", "label": "Prov/DXCC", "type": "text",
      "width": 85, "required": true, "entryRow": 0,
      "options": [
        "AG","AL","AN","AO","AP","AQ","AR","AT","AV",
        "BA","BG","BI","BL","BN","BO","BR","BS","BT","BZ",
        "CA","CB","CE","CH","CI","CL","CN","CO","CR","CS","CT","CZ",
        "EN","FC","FE","FG","FI","FM","FR",
        "GE","GO","GR",
        "IM","IS","KR",
        "LC","LE","LI","LO","LT","LU",
        "MB","MC","ME","MI","MN","MO","MS","MT",
        "NA","NO","NU",
        "OG","OR","OT",
        "PA","PC","PD","PE","PG","PI","PN","PO","PR","PT","PU","PV","PZ",
        "RA","RC","RE","RG","RI","RM","RN","RO",
        "SA","SI","SO","SP","SR","SS","SU","SV",
        "TA","TE","TN","TO","TP","TR","TS","TV",
        "UD","VA","VB","VC","VE","VI","VR","VS","VT","VV"
      ]
    },
    { "id": "serial_rcvd", "label": "# R", "type": "text", "width": 60, "required": false, "entryRow": 0, "validator": "numeric" },
    { "id": "rst_sent", "label": "RST S", "type": "text", "width": 50, "required": false, "entryRow": 1 },
    { "id": "state_prov_sent", "label": "Prov S", "type": "text", "width": 85, "required": false, "entryRow": 1, "persistent": true }
  ],

  "conditionalFields": [
    { "fieldId": "serial_rcvd", "showForRegions": ["US","CA","DX"] }
  ],

  "scoringRules": {
    "pointsPerQso": 3,
    "modePoints":   {},
    "multiplierType": "custom",
    "scoreFormula": "qsoPoints * multipliers",
    "allowDupes":   false
  },

  "multiplierModel": {
    "field":   "state_prov_rcvd",
    "perBand": true,
    "validValues": []
  },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "dxcc_list",     "title": "Provinces / DXCC", "config": {} },
    { "paneIndex": 3, "paneType": "statistics",    "title": "Statistics",    "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloMapping": {
    "callsign":        "rcvd_callsign",
    "rst_sent":        "sent_rst",
    "rst_rcvd":        "rcvd_rst",
    "state_prov_sent": "sent_exchange",
    "state_prov_rcvd": "rcvd_exchange",
    "serial_rcvd":     "rcvd_exchange"
  },

  "sections": []
}

{
  "contestId":   "ARI_DX",
  "contestName": "ARI International DX Contest (Italy)",
  "version":     "1.1.0",

  "exchangeFormat": "Italian stations: RST + 2-letter province (e.g. 599 MI). Others: RST + serial from 001, NOT restarting per band/mode (continuous). CW/SSB/RTTY, 160-10m no WARC (RTTY: 80-10m).",

  "stationClassifier": "callsignRegion",

  "entryFields": [
    { "id": "callsign", "label": "Callsign", "type": "text", "width": 140, "required": true, "entryRow": 0 },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["160m","80m","40m","20m","15m","10m"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW","SSB","USB","LSB","RTTY"]
    },
    { "id": "rst_rcvd", "label": "RST R", "type": "text", "width": 50, "required": true, "entryRow": 0 },
    {
      "id": "state_prov_rcvd", "label": "Prov", "type": "text",
      "width": 70, "required": false, "entryRow": 0,
      "options": [
        "AG","AL","AN","AO","AP","AQ","AR","AT","AV",
        "BA","BG","BI","BL","BN","BO","BR","BS","BT","BZ",
        "CA","CB","CE","CH","CI","CL","CN","CO","CR","CS","CT","CZ",
        "EN","FC","FE","FG","FI","FM","FR",
        "GE","GO","GR",
        "IM","IS","KR",
        "LC","LE","LI","LO","LT","LU",
        "MB","MC","ME","MI","MN","MO","MS","MT",
        "NA","NO","NU",
        "OG","OR","OT",
        "PA","PC","PD","PE","PG","PI","PN","PO","PR","PS","PT","PU","PV","PZ",
        "RA","RC","RE","RG","RI","RM","RN","RO",
        "SA","SI","SO","SP","SR","SS","SV",
        "TA","TE","TN","TO","TP","TR","TS","TV",
        "UD","VA","VB","VC","VE","VI","VR","VS","VT","VV"
      ]
    },
    { "id": "serial_rcvd", "label": "# R", "type": "text", "width": 60, "required": false, "entryRow": 0, "validator": "numeric" },
    { "id": "rst_sent", "label": "RST S", "type": "text", "width": 50, "required": true, "entryRow": 1 },
    { "id": "state_prov_sent", "label": "Prov S", "type": "text", "width": 70, "required": false, "entryRow": 1, "persistent": true }
  ],

  "conditionalFields": [
    { "fieldId": "serial_rcvd", "showForRegions": ["US","CA","DX"] }
  ],

  "scoringRules": {
    "pointsPerQso": 1,
    "multiplierType": "ari_dx",
    "scoreFormula": "Σ QSO pts × Σ mults, both summed over all bands. Pts: own DXCC 0 (still a mult) / any Italian station (I & IS0) 10 / own continent 1 / different continent 3. Mult: each Italian province + each DXCC country EXCEPT I & IS0, counted once per band; only the first QSO with a given mult/band credits it. Claimed — the ARI committee re-adjudicates.",
    "allowDupes": false
  },

  "multiplierModel": { "field": "state_prov_rcvd", "perBand": true, "validValues": [] },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "statistics",    "title": "Statistics",    "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloSent": ["rst_sent", "state_prov_sent", "serial_sent"],
  "cabrilloRcvd": ["rst_rcvd", "state_prov_rcvd", "serial_rcvd"],

  "sections": []
}

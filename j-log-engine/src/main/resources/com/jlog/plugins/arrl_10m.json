{
  "contestId":   "ARRL_10M",
  "contestName": "ARRL 10-Meter Contest",
  "version":     "1.1.0",

  "exchangeFormat": "W/VE+MX: RST + State/Prov (D.C. = DC; AK/HI = US states)   DX: RST + Serial   MM: RST + ITU region (1-3)",

  "lockedBand": "10m",
  "perModeMultipliers": true,
  "stationClassifier":  "callsignRegion",

  "entryFields": [
    {
      "id": "callsign", "label": "Callsign", "type": "text",
      "width": 140, "required": true, "entryRow": 0
    },
    {
      "id": "mode", "label": "Mode", "type": "combo",
      "width": 80, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW","Phone"]
    },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": false, "entryRow": 0,
      "persistent": true
    },
    {
      "id": "rst_rcvd", "label": "RST R", "type": "text",
      "width": 50, "required": true, "entryRow": 0
    },
    {
      "id": "state_prov_rcvd", "label": "St/Pv", "type": "text",
      "width": 65, "required": false, "entryRow": 0
    },
    {
      "id": "serial_rcvd", "label": "Serial", "type": "text",
      "width": 70, "required": false, "entryRow": 0,
      "validator": "numeric"
    },
    {
      "id": "rst_sent", "label": "RST S", "type": "text",
      "width": 50, "required": true, "entryRow": 1
    },
    {
      "id": "state_prov_sent", "label": "St/Pv", "type": "text",
      "width": 65, "required": false, "entryRow": 1,
      "persistent": true
    }
  ],

  "conditionalFields": [
    { "fieldId": "state_prov_rcvd", "showForRegions": ["US","CA"] },
    { "fieldId": "serial_rcvd",     "showForRegions": ["DX"] }
  ],

  "scoringRules": {
    "pointsPerQso":  2,
    "modePoints":    { "CW": 4, "Phone": 2 },
    "multiplierType": "custom",
    "scoreFormula":  "qsoPoints * multipliers",
    "allowDupes":    false
  },

  "multiplierModel": {
    "field":  "state_prov_rcvd",
    "perBand": false,
    "validValues": [
      "AL","AK","AZ","AR","CA","CO","CT","DC","DE","FL","GA",
      "HI","ID","IL","IN","IA","KS","KY","LA","ME","MD",
      "MA","MI","MN","MS","MO","MT","NE","NV","NH","NJ",
      "NM","NY","NC","ND","OH","OK","OR","PA","RI","SC",
      "SD","TN","TX","UT","VT","VA","WA","WV","WI","WY",
      "AB","BC","MB","NB","NL","NS","NT","NU","ON","PE","QC","SK","YT"
    ]
  },

  "usStates": [
    "AL","AK","AZ","AR","CA","CO","CT","DC","DE","FL","GA",
    "HI","ID","IL","IN","IA","KS","KY","LA","ME","MD",
    "MA","MI","MN","MS","MO","MT","NE","NV","NH","NJ",
    "NM","NY","NC","ND","OH","OK","OR","PA","RI","SC",
    "SD","TN","TX","UT","VT","VA","WA","WV","WI","WY"
  ],

  "canadaProvinces": [
    "AB","BC","MB","NB","NL","NS","NT","NU","ON","PE","QC","SK","YT"
  ],

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "us_state_map",  "title": "U.S. States",   "config": {} },
    { "paneIndex": 3, "paneType": "canada_map",    "title": "Canada",        "config": {} },
    { "paneIndex": 4, "paneType": "dxcc_list",     "title": "DXCC",          "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloSent": ["rst_sent", "state_prov_sent"],
  "cabrilloRcvd": ["rst_rcvd", "state_prov_rcvd", "serial_rcvd"],

  "sections": [
    "AL","AK","AZ","AR","CA","CO","CT","DC","DE","FL","GA",
    "HI","ID","IL","IN","IA","KS","KY","LA","ME","MD",
    "MA","MI","MN","MS","MO","MT","NE","NV","NH","NJ",
    "NM","NY","NC","ND","OH","OK","OR","PA","RI","SC",
    "SD","TN","TX","UT","VT","VA","WA","WV","WI","WY",
    "AB","BC","MB","NB","NL","NS","NT","NU","ON","PE","QC","SK","YT"
  ]
}

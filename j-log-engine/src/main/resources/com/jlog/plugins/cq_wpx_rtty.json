{
  "contestId":   "CQ_WPX_RTTY",
  "contestName": "CQ Worked All Prefixes (RTTY)",
  "version":     "1.1.0",

  "exchangeFormat": "RST + serial (e.g. 599 001). Mult = distinct WPX prefixes (contest-wide); QSO pts by continent × band group.",

  "lockedMode":         "RTTY",
  "autoFillWpxPrefix":  true,

  "entryFields": [
    {
      "id": "callsign", "label": "Callsign", "type": "text",
      "width": 140, "required": true, "entryRow": 0
    },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["160m","80m","40m","20m","15m","10m"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 60, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["RTTY"]
    },
    {
      "id": "rst_rcvd", "label": "RST R", "type": "text",
      "width": 50, "required": true, "entryRow": 0
    },
    {
      "id": "serial_rcvd", "label": "# R", "type": "text",
      "width": 60, "required": true, "entryRow": 0,
      "validator": "numeric"
    },
    {
      "id": "prefix_rcvd", "label": "Prefix", "type": "text",
      "width": 70, "required": true, "entryRow": 0
    },
    {
      "id": "rst_sent", "label": "RST S", "type": "text",
      "width": 50, "required": true, "entryRow": 1
    }
  ],

  "scoringRules": {
    "pointsPerQso":  1,
    "multiplierType": "wpx_prefix",
    "scoreFormula":  "totalQsoPoints * distinctPrefixes (contest-wide); QSO pts Rule V.B: diff-cont 3/6, same-cont diff-cty 1/2 (NA-NA 2/4), same-cty 1; LF=40/80/160m doubles",
    "allowDupes":    false
  },

  "multiplierModel": {
    "field":   "prefix_rcvd",
    "perBand": false,
    "validValues": []
  },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before",   "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "statistics",      "title": "Statistics", "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour","prefixes_worked"],

  "cabrilloSent": ["rst_sent", "serial_sent"],
  "cabrilloRcvd": ["rst_rcvd", "serial_rcvd"],

  "sections": []
}

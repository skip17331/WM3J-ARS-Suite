{
  "contestId":   "WI_QSO_PARTY",
  "contestName": "Wisconsin QSO Party",
  "version":     "1.0.0",

  "exchangeFormat": "WI: county (3-letter). Non-WI: state/province/country. CW/Phone/Digital (RTTY/PSK/Olivia/Feld-Hell — no FT8/FT4). WI works everyone; non-WI works WI only.",

  "stationClassifier": "callsignRegion",

  "entryFields": [
    { "id": "callsign", "label": "Callsign", "type": "text", "width": 140, "required": true, "entryRow": 0 },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["160m","80m","40m","20m","15m","10m","6m","2m","1.25m","70cm"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW","SSB","USB","LSB","RTTY","PSK31","Olivia","Digital"]
    },
    { "id": "rst_rcvd", "label": "RST R", "type": "text", "width": 50, "required": false, "entryRow": 0 },
    { "id": "state_prov_rcvd", "label": "Co/St R", "type": "text", "width": 90, "required": true, "entryRow": 0 },
    { "id": "rst_sent", "label": "RST S", "type": "text", "width": 50, "required": false, "entryRow": 1 },
    { "id": "state_prov_sent", "label": "My Co/St", "type": "text", "width": 90, "required": false, "entryRow": 1, "persistent": true }
  ],

  "scoringRules": {
    "pointsPerQso": 1,
    "multiplierType": "qso_party",
    "scoreFormula": "(Σ QSO pts × power-mult × Σ mults) + bonus. Pts: Phone 1, CW/Digital 2. Mults counted ONCE: WI entrant = WI counties + US states (WI allowed) + CA provinces (DX = QSO pts only, no mult); non-WI entrant = WI counties only. W9FK = +100 per band+mode (post-multiply). Power mult ×2/×1.5/×1 (QRP/Low/High) and WI mobile/portable +500/county@≥12 are OFF-LOG/claimed (entrant category / self-report). Claimed — WIQP committee re-adjudicates.",
    "allowDupes": false,
    "qsoParty": {
      "stateName": "Wisconsin",
      "stateAbbr": "WI",
      "countyCodeLen": 3,
      "pointsByModeClass": { "PH": 1, "CW": 2, "DG": 2 },
      "multScope": "once",
      "inStateCountsStates": true,
      "inStateCountsDxccEach": false,
      "inStateCountsCounties": true,
      "inStateNoDxMult": true,
      "mergeRttyDigital": true,
      "ft8GridDivisor": 0,
      "outStateGridCap": 0,
      "bonusStations": { "W9FK": 100 }
    }
  },

  "multiplierModel": { "field": "state_prov_rcvd", "perBand": false, "validValues": [] },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "worked_mults",  "title": "WI Counties / Mults", "config": {} },
    { "paneIndex": 3, "paneType": "statistics",    "title": "Statistics", "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloSent": ["rst_sent", "state_prov_sent"],
  "cabrilloRcvd": ["rst_rcvd", "state_prov_rcvd"],

  "sections": []
}

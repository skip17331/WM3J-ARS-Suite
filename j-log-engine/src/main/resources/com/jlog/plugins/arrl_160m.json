{
  "contestId":   "ARRL_160M",
  "contestName": "ARRL 160-Meter Contest",
  "version":     "1.1.0",

  "exchangeFormat": "W/VE: RST + ARRL/RAC Section.  DX: RST only (DXCC entity auto-derived for the multiplier).  e.g. 599 EMA, 599 ONS, 599 (DX)",

  "lockedBand":  "160m",
  "lockedMode":  "CW",
  "perModeMultipliers": false,
  "stationClassifier":  "callsignRegion",
  "autoFillDxccPrefix": true,

  "entryFields": [
    {
      "id": "callsign", "label": "Callsign", "type": "text",
      "width": 140, "required": true, "entryRow": 0
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 60, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW"]
    },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": false, "entryRow": 0,
      "persistent": true,
      "options": ["160m"]
    },
    {
      "id": "rst_rcvd", "label": "RST R", "type": "text",
      "width": 50, "required": true, "entryRow": 0
    },
    {
      "id": "state_prov_rcvd", "label": "Sect/DX", "type": "text",
      "width": 70, "required": true, "entryRow": 0
    },
    {
      "id": "rst_sent", "label": "RST S", "type": "text",
      "width": 50, "required": true, "entryRow": 1
    },
    {
      "id": "state_prov_sent", "label": "Sect S", "type": "text",
      "width": 70, "required": false, "entryRow": 1,
      "persistent": true
    }
  ],

  "scoringRules": {
    "pointsPerQso":  2,
    "modePoints":    {},
    "pointsByRegionPair": {
      "US_US": 2, "US_CA": 2, "US_DX": 5,
      "CA_US": 2, "CA_CA": 2, "CA_DX": 5,
      "DX_US": 5, "DX_CA": 5, "DX_DX": 2
    },
    "multiplierType": "custom",
    "scoreFormula":  "qsoPoints * multipliers (Rule 5: 2 pts W/VE-W/VE, 5 pts W/VE-DX; mults = ARRL/RAC sections + DXCC entities)",
    "allowDupes":    false
  },

  "multiplierModel": {
    "field":  "state_prov_rcvd",
    "perBand": false,
    "validValues": [
      "CT","EMA","ME","NH","RI","VT","WMA",
      "ENY","NLI","NNJ","NNY","SNJ","WNY",
      "DE","EPA","MDC","WPA",
      "AL","GA","KY","NC","NFL","SC","SFL","TN","VA","WCF","PR","VI",
      "AR","LA","MS","NM","NTX","OK","STX","WTX",
      "EB","LAX","ORG","SB","SCV","SDG","SF","SJV","SV","PAC",
      "AK","AZ","EWA","ID","MT","NV","OR","UT","WWA","WY",
      "MI","OH","WV",
      "IL","IN","WI",
      "CO","IA","KS","MN","MO","NE","ND","SD",
      "AB","BC","GH","MB","NB","NL","NS","ONE","ONN","ONS","PE","QC","SK","TER"
    ]
  },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    {
      "paneIndex": 2,
      "paneType":  "section_tracker",
      "title":     "Sections Worked",
      "config": {
        "zoneGroups": [
          { "name": "W1", "sections": ["CT","EMA","ME","NH","RI","VT","WMA"] },
          { "name": "W2", "sections": ["ENY","NLI","NNJ","NNY","SNJ","WNY"] },
          { "name": "W3", "sections": ["DE","EPA","MDC","WPA"] },

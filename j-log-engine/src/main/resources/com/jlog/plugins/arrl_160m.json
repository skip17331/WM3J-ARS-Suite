          { "name": "W6", "sections": ["EB","LAX","ORG","SB","SCV","SDG","SF","SJV","SV","PAC"] },
          { "name": "W7", "sections": ["AK","AZ","EWA","ID","MT","NV","OR","UT","WWA","WY"] },
          { "name": "W8", "sections": ["MI","OH","WV"] },
          { "name": "W9", "sections": ["IL","IN","WI"] },
          { "name": "W0", "sections": ["CO","IA","KS","MN","MO","NE","ND","SD"] },
          { "name": "VE", "sections": ["AB","BC","GH","MB","NB","NL","NS","ONE","ONN","ONS","PE","QC","SK","TER"] }
        ]

{
  "contestId":   "WA_QSO_PARTY",
  "contestName": "Washington Salmon Run (WA QSO Party)",
  "version":     "1.2.0",

  "exchangeFormat": "WA: RS(T) + WA county. USA: RS(T) + state. Canada: RS(T) + Canadian multiplier. DX: RS(T) + DXCC entity prefix. Bands 160-10m + 6m (no WARC). CW/Phone only (no WSJT). WA works everyone; non-WA works WA only.",

  "stationClassifier": "callsignRegion",

  "entryFields": [
    { "id": "callsign", "label": "Callsign", "type": "text", "width": 140, "required": true, "entryRow": 0 },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["160m","80m","40m","20m","15m","10m","6m"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW","SSB","USB","LSB"]
    },
    { "id": "rst_rcvd", "label": "RST R", "type": "text", "width": 50, "required": true, "entryRow": 0 },
    { "id": "state_prov_rcvd", "label": "Co/St R", "type": "text", "width": 90, "required": true, "entryRow": 0 },
    { "id": "rst_sent", "label": "RST S", "type": "text", "width": 50, "required": true, "entryRow": 1 },
    { "id": "state_prov_sent", "label": "My Co/St", "type": "text", "width": 90, "required": false, "entryRow": 1, "persistent": true }
  ],

  "multiplierList": "/com/jlog/counties/wa.json",

  "scoringRules": {
    "pointsPerQso": 1,
    "multiplierType": "qso_party",
    "scoreFormula": "(Σ QSO pts × Σ mults, counted ONLY ONCE regardless of band/mode) + W7DX bonus. Pts: Phone 2, CW 3 (same station per band on Phone and CW). WA entrant mult = WA counties (39) + US states less WA (49, DC→MD, AK/HI=states) + VE (13) + up to 10 DXCC (US/VE not DX). Non-WA entrant mult = WA counties (39). WA works everyone; non-WA scores WA contacts only (non-WA↔non-WA no credit). County-change = new QSO + new county; mults counted once (not per activated county). Special bonus station W7DX = +500 per MODE (Phone & CW), max 1000, post-multiply; W7DX also gives its normal county mult + 2/3 QSO pts. Claimed/running — the WWDXC Salmon Run committee re-adjudicates. NOT enforced (claimed): DXCC 'up to 10' cap. NOT applied (category): power/operator/expedition categories.",
    "allowDupes": false,
    "qsoParty": {
      "stateName": "Washington",
      "stateAbbr": "WA",
      "countyByExclusion": true,
      "pointsByModeClass": { "PH": 2, "CW": 3 },
      "multScope": "once",
      "inStateCountsCounties": true,
      "inStateOwnStateMult": false,
      "inStateSelfStateMult": false,
      "inStateCountsStates": true,
      "inStateCountsDxccEach": true,
      "inStateNoDxMult": false,
      "bonusStationsPerMode": { "W7DX": 500 },
      "ft8GridDivisor": 0,
      "outStateGridCap": 0
    }
  },

  "multiplierModel": { "field": "state_prov_rcvd", "perBand": false, "validValues": [] },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "worked_mults",  "title": "WA Counties / Mults", "config": {} },
    { "paneIndex": 3, "paneType": "statistics",    "title": "Statistics", "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloSent": ["rst_sent", "state_prov_sent"],
  "cabrilloRcvd": ["rst_rcvd", "state_prov_rcvd"],

  "sections": []
}

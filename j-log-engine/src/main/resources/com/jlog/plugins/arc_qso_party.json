{
  "contestId":   "ARC_QSO_PARTY",
  "contestName": "Amateur Radio Club QSO Party",
  "version":     "2.0.0",

  "exchangeFormat": "Call + class letter: R registered club station, U unregistered club station, C club member, N not a club member, Y youth operator (18 or under). Club stations sign call/club age (K2AA/110 R). Everyone works everyone, once per band and mode. Bands: all except 60/30/17/12m; repeater contacts allowed (= phone).",

  "stationClassifier": "callsignRegion",

  "entryFields": [
    { "id": "callsign", "label": "Callsign", "type": "text", "width": 140, "required": true, "entryRow": 0 },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["160m","80m","40m","20m","15m","10m","6m","2m","70cm"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW","SSB","USB","LSB","FM","AM","RTTY","PSK31","Digital"]
    },
    { "id": "rst_rcvd", "label": "RST R", "type": "text", "width": 50, "required": false, "entryRow": 0 },
    { "id": "state_prov_rcvd", "label": "Class", "type": "text", "width": 70, "required": true, "entryRow": 0, "options": ["R","U","C","N","Y"] },
    { "id": "rst_sent", "label": "RST S", "type": "text", "width": 50, "required": false, "entryRow": 1 },
    { "id": "state_prov_sent", "label": "My class", "type": "text", "width": 70, "required": false, "entryRow": 1, "persistent": true, "options": ["R","U","C","N","Y"] }
  ],

  "scoringRules": {
    "pointsPerQso": 1,
    "multiplierType": "qso_party",
    "scoreFormula": "Σ QSO points, no multiplier (rules 2026, II.E). Points by the class the other station sends: R registered club station 100, U unregistered club station 50, C club member 5, N non-member 3, Y youth (18 or under) 20; mode does not matter. Once per band and mode. Rules: sites.google.com/view/wwwclubqsopartyorg/rules (2026-06 event, read 2026-11-18); one line there (V.C, 'registered clubs are worth 50 points instead of 20') contradicts every other statement of the values on both pages and is not followed. A QSO with no class letter scores 0. The club competition (score divided by 1 - members worked / active members) is calculated by the sponsor.",
    "allowDupes": false,
    "qsoParty": {
      "stateName": "Amateur Radio Clubs",
      "stateAbbr": "ARC",
      "pointsAllQsos": true,
      "pointsByRcvd": { "R": 100, "U": 50, "C": 5, "N": 3, "Y": 20 },
      "noMultiplier": true,
      "ft8GridDivisor": 0,
      "outStateGridCap": 0
    }
  },

  "multiplierModel": { "field": "state_prov_rcvd", "perBand": false, "validValues": ["R","U","C","N","Y"] },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "worked_mults",  "title": "Classes Worked", "config": {} },
    { "paneIndex": 3, "paneType": "statistics",    "title": "Statistics", "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloSent": ["rst_sent", "state_prov_sent"],
  "cabrilloRcvd": ["rst_rcvd", "state_prov_rcvd"],

  "sections": [],
  "layout": {
    "fieldOrder": ["callsign", "state_prov_rcvd", "rst_rcvd"],
    "tiles": ["qsosByBand"],
    "macroSet": "contest",
    "cq": "CQ QP {MYCALL}"
  }
}

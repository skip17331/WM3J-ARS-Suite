{
  "contestId":   "AL_QSO_PARTY",
  "contestName": "Alabama QSO Party",
  "version":     "1.0.0",

  "exchangeFormat": "AL: RST + AL county. W/VE (incl KH6/KL7): RST + state/province (DC→MD). DX (incl KP2/KP4): RST + DXCC country prefix. Bands 80-10m (no WARC). CW/Phone only. AL works the world; non-AL works AL only.",

  "stationClassifier": "callsignRegion",

  "entryFields": [
    { "id": "callsign", "label": "Callsign", "type": "text", "width": 140, "required": true, "entryRow": 0 },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["80m","40m","20m","15m","10m"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW","SSB","USB","LSB"]
    },
    { "id": "rst_rcvd", "label": "RST R", "type": "text", "width": 50, "required": true, "entryRow": 0 },
    { "id": "state_prov_rcvd", "label": "Co/St R", "type": "text", "width": 90, "required": true, "entryRow": 0 },
    { "id": "rst_sent", "label": "RST S", "type": "text", "width": 50, "required": true, "entryRow": 1 },
    { "id": "state_prov_sent", "label": "My Co/St", "type": "text", "width": 90, "required": false, "entryRow": 1, "persistent": true }
  ],

  "scoringRules": {
    "pointsPerQso": 2,
    "multiplierType": "qso_party",
    "scoreFormula": "Σ QSO pts × Σ mults (each counted ONCE PER MODE). Pts: CW and Phone both 2/QSO. AL entrant mult = AL counties (67, from AL stations) + each US state (50, AL counts as a state, DC→MD) + Canadian provinces (13) + each DXCC entity — 63/mode + 67 counties + DXCC. Non-AL entrant mult = AL counties (67/mode, 134 mixed). AL works the world; non-AL scores AL contacts only (non-AL↔non-AL no credit). Stations worked on multiple bands for QSO credit; mults once per mode. AL mobiles county-change = new QSO + new county (no county-line sitting). Claimed/running — the AQP committee re-adjudicates.",
    "allowDupes": false,
    "qsoParty": {
      "stateName": "Alabama",
      "stateAbbr": "AL",
      "countyByExclusion": true,
      "multScope": "per_mode",
      "inStateCountsCounties": true,
      "inStateOwnStateMult": false,
      "inStateSelfStateMult": true,
      "inStateCountsStates": true,
      "inStateCountsDxccEach": true,
      "inStateNoDxMult": false,
      "ft8GridDivisor": 0,
      "outStateGridCap": 0
    }
  },

  "multiplierModel": { "field": "state_prov_rcvd", "perBand": false, "validValues": [] },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "worked_mults",  "title": "AL Counties / Mults", "config": {} },
    { "paneIndex": 3, "paneType": "statistics",    "title": "Statistics", "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloSent": ["rst_sent", "state_prov_sent"],
  "cabrilloRcvd": ["rst_rcvd", "state_prov_rcvd"],

  "sections": []
}

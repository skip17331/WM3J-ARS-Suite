{
  "contestId":   "CQ_160M_CW",
  "contestName": "CQ 160-Meter Contest (CW)",
  "version":     "1.1.0",

  "exchangeFormat": "RST + State (US) / Prov (VE) / CQ Zone (DX). Zone is a location indicator only, NOT a mult. e.g. 599 PA  /  599 ON  /  599 14",

  "lockedBand":  "160m",
  "lockedMode":  "CW",

  "entryFields": [
    {
      "id": "callsign", "label": "Callsign", "type": "text",
      "width": 140, "required": true, "entryRow": 0
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 60, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW"]
    },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["160m"]
    },
    {
      "id": "rst_rcvd", "label": "RST R", "type": "text",
      "width": 50, "required": true, "entryRow": 0
    },
    {
      "id": "state_prov_rcvd", "label": "St/Pv/Zn", "type": "text",
      "width": 75, "required": true, "entryRow": 0
    },
    {
      "id": "rst_sent", "label": "RST S", "type": "text",
      "width": 50, "required": true, "entryRow": 1
    },
    {
      "id": "state_prov_sent", "label": "My St/Pv/Zn", "type": "text",
      "width": 75, "required": false, "entryRow": 1,
      "persistent": true
    }
  ],

  "scoringRules": {
    "pointsPerQso":  2,
    "multiplierType": "state_prov_country",
    "scoreFormula":  "totalQsoPoints * distinctMults (US states + VE provinces + DXCC/WAE countries, contest-wide); QSO pts Rule VI: own-cty 2, same-cont 5, diff-cont 10, MM 5",
    "allowDupes":    false
  },

  "multiplierModel": {
    "field":   "state_prov_rcvd",
    "perBand": false,
    "validValues": []
  },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "statistics",    "title": "Statistics",    "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloMapping": {
    "callsign":         "rcvd_callsign",
    "rst_sent":         "sent_rst",
    "state_prov_sent":  "sent_state",
    "rst_rcvd":         "rcvd_rst",
    "state_prov_rcvd":  "rcvd_state"
  },

  "sections": []
}

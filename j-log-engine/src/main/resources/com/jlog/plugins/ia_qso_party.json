{
  "contestId":   "IA_QSO_PARTY",
  "contestName": "Iowa QSO Party",
  "version":     "1.0.0",

  "exchangeFormat": "IA: RST + IA county. US/Canada: RST + state/province. DX: RST + 'DX'. Bands: all except 60/30/17/12m. Phone (incl digital phone) / CW / Digital. Satellite OK. IA works everyone; non-IA works IA only.",

  "stationClassifier": "callsignRegion",

  "entryFields": [
    { "id": "callsign", "label": "Callsign", "type": "text", "width": 140, "required": true, "entryRow": 0 },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["160m","80m","40m","20m","15m","10m","6m","2m","1.25m","70cm"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW","SSB","USB","LSB","FM","RTTY","PSK31","Digital"]
    },
    { "id": "rst_rcvd", "label": "RST R", "type": "text", "width": 50, "required": true, "entryRow": 0 },
    { "id": "state_prov_rcvd", "label": "Co/St R", "type": "text", "width": 90, "required": true, "entryRow": 0 },
    { "id": "rst_sent", "label": "RST S", "type": "text", "width": 50, "required": true, "entryRow": 1 },
    { "id": "state_prov_sent", "label": "My Co/St", "type": "text", "width": 90, "required": false, "entryRow": 1, "persistent": true }
  ],

  "scoringRules": {
    "pointsPerQso": 1,
    "multiplierType": "qso_party",
    "scoreFormula": "Σ QSO pts × Σ mults (applied ONCE, NOT per band, NOT per mode). Pts: Phone 1, CW 2, Digital 2. IA works everyone; non-IA scores IA contacts only (non-IA↔non-IA no credit). IA entrant mult = each IA county + each US state (INCLUDING Iowa) + each Canadian province; DX = QSO points only (NO DX mult). Non-IA entrant mult = each IA county. IA mobile/rover county-change = new station; county-line = represents all intersecting counties (log each). Claimed/running — the SCARC Iowa QSO Party council re-adjudicates. NOT applied (category): power/operator categories. (FT8/FT4 effectively unusable per rules — full exchange impossible; if logged they score as Digital, claimed.)",
    "allowDupes": false,
    "qsoParty": {
      "stateName": "Iowa",
      "stateAbbr": "IA",
      "countyByExclusion": true,
      "pointsByModeClass": { "PH": 1, "CW": 2, "DG": 2 },
      "multScope": "once",
      "inStateCountsCounties": true,
      "inStateOwnStateMult": false,
      "inStateSelfStateMult": true,
      "inStateCountsStates": true,
      "inStateCountsDxccEach": false,
      "inStateNoDxMult": true,
      "mergeRttyDigital": true,
      "ft8GridDivisor": 0,
      "outStateGridCap": 0
    }
  },

  "multiplierModel": { "field": "state_prov_rcvd", "perBand": false, "validValues": [] },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "worked_mults",  "title": "IA Counties / Mults", "config": {} },
    { "paneIndex": 3, "paneType": "statistics",    "title": "Statistics", "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloMapping": {
    "callsign":        "rcvd_callsign",
    "rst_sent":        "sent_rst",
    "rst_rcvd":        "rcvd_rst",
    "state_prov_sent": "sent_exchange",
    "state_prov_rcvd": "rcvd_exchange"
  },

  "sections": []
}

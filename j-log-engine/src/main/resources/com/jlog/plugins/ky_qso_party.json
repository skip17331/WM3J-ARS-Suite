{
  "contestId":   "KY_QSO_PARTY",
  "contestName": "Kentucky QSO Party",
  "version":     "1.0.0",

  "exchangeFormat": "KY: RST + KY county. Non-KY US: RST + state (incl DC). Canada: RST + province. DX: RST + 'DX'. Bands 80-10m + 6m + 2m. CW/Phone only (NO digital). KY works everyone; non-KY works KY only (non-KY↔non-KY no credit).",

  "stationClassifier": "callsignRegion",

  "entryFields": [
    { "id": "callsign", "label": "Callsign", "type": "text", "width": 140, "required": true, "entryRow": 0 },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["80m","40m","20m","15m","10m","6m","2m"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW","SSB","USB","LSB","FM"]
    },
    { "id": "rst_rcvd", "label": "RST R", "type": "text", "width": 50, "required": true, "entryRow": 0 },
    { "id": "state_prov_rcvd", "label": "Co/St R", "type": "text", "width": 90, "required": true, "entryRow": 0 },
    { "id": "rst_sent", "label": "RST S", "type": "text", "width": 50, "required": true, "entryRow": 1 },
    { "id": "state_prov_sent", "label": "My Co/St", "type": "text", "width": 90, "required": false, "entryRow": 1, "persistent": true }
  ],

  "scoringRules": {
    "pointsPerQso": 1,
    "multiplierType": "qso_party",
    "scoreFormula": "Σ QSO pts × Σ mults (counted ONCE PER CONTEST) [× Power Mult — off-log] + K4KCG bonus + e-log bonus. Pts: Phone 1, CW 2. KY entrant mult = each KY county (120, from KY stations) + each US state incl DC + each Canadian province; DX = QSO pts only (no mult). Non-KY entrant mult = KY counties. KY works everyone; non-KY scores KY contacts only (non-KY↔non-KY no credit). KY mobiles/expeditions county-change = new QSO + new county; KY fixed picks one county on a line. Bonus station K4KCG = +100 per QSO, once per band & mode (post-multiply). Claimed/running — the KYQP committee re-adjudicates. NOT applied (off-log): Power Multiplier (×3 ≤5W / ×2 ≤100W / ×1 >100W, default ×1); +100 electronic-submission bonus.",
    "allowDupes": false,
    "qsoParty": {
      "stateName": "Kentucky",
      "stateAbbr": "KY",
      "countyByExclusion": true,
      "pointsByModeClass": { "PH": 1, "CW": 2 },
      "multScope": "once",
      "inStateCountsCounties": true,
      "inStateOwnStateMult": false,
      "inStateCountsStates": true,
      "inStateCountsDxccEach": false,
      "inStateNoDxMult": true,
      "bonusStations": { "K4KCG": 100 },
      "ft8GridDivisor": 0,
      "outStateGridCap": 0
    }
  },

  "multiplierModel": { "field": "state_prov_rcvd", "perBand": false, "validValues": [] },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "worked_mults",  "title": "KY Counties / Mults", "config": {} },
    { "paneIndex": 3, "paneType": "statistics",    "title": "Statistics", "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloMapping": {
    "callsign":        "rcvd_callsign",
    "rst_sent":        "sent_rst",
    "rst_rcvd":        "rcvd_rst",
    "state_prov_sent": "sent_exchange",
    "state_prov_rcvd": "rcvd_exchange"
  },

  "sections": []
}

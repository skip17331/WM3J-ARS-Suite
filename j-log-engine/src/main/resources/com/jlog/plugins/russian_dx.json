{
  "contestId":   "RUSSIAN_DX",
  "contestName": "Russian DX Contest",
  "version":     "1.1.0",

  "exchangeFormat": "Russian: RST + oblast code (e.g. 599 MO). Non-Russian: RST + serial from 001 (§6). Mixed CW+SSB (workable twice/band, §5.6).",

  "stationClassifier":  "callsignRegion",

  "entryFields": [
    { "id": "callsign", "label": "Callsign", "type": "text", "width": 140, "required": true, "entryRow": 0 },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["160m","80m","40m","20m","15m","10m"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["CW","SSB","USB","LSB"]
    },
    { "id": "rst_rcvd", "label": "RST R", "type": "text", "width": 50, "required": true, "entryRow": 0 },
    {
      "id": "state_prov_rcvd", "label": "Oblast", "type": "text",
      "width": 70, "required": false, "entryRow": 0
    },
    { "id": "serial_rcvd", "label": "# R", "type": "text", "width": 60, "required": false, "entryRow": 0, "validator": "numeric" },
    { "id": "rst_sent", "label": "RST S", "type": "text", "width": 50, "required": true, "entryRow": 1 },
    { "id": "state_prov_sent", "label": "My Obl/#", "type": "text", "width": 70, "required": false, "entryRow": 1, "persistent": true }
  ],

  "conditionalFields": [
    { "fieldId": "serial_rcvd", "showForRegions": ["US","CA","DX"] }
  ],

  "scoringRules": {
    "pointsPerQso": 1,
    "multiplierType": "russian_dx",
    "scoreFormula": "Σ QSO pts × Σ (oblast + country) mults per band (§9/§10). Pts §7: RU entrant — vs RU same-cont 2 / other 5, vs other-cty same-cont 3 / other 5; non-RU — vs RU 10, own-cty 2, same-cont 3, other 5; MM 5 (§7.4). UA2F/RI1FJ/RI1AN = separate country + oblast (§7.3). Claimed — RDXC re-adjudicates.",
    "allowDupes": false
  },

  "multiplierModel": { "field": "state_prov_rcvd", "perBand": true, "validValues": [] },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "statistics",    "title": "Statistics",    "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloSent": ["rst_sent", "state_prov_sent"],
  "cabrilloRcvd": ["rst_rcvd", "state_prov_rcvd", "serial_rcvd"],

  "sections": []
}

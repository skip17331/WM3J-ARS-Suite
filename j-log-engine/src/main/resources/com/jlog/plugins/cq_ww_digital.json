{
  "contestId":   "CQ_WW_DIGITAL",
  "contestName": "World Wide Digi DX Contest",
  "version":     "1.1.0",

  "exchangeFormat": "4-character Maidenhead grid square (e.g. FN20). FT4 / FT8 only.",

  "roverAwareDupe": true,

  "entryFields": [
    {
      "id": "callsign", "label": "Callsign", "type": "text",
      "width": 140, "required": true, "entryRow": 0
    },
    {
      "id": "band", "label": "Band", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["160m","80m","40m","20m","15m","10m"]
    },
    {
      "id": "mode", "label": "Mode", "type": "text",
      "width": 60, "required": true, "entryRow": 0,
      "persistent": true,
      "options": ["FT8","FT4"]
    },
    {
      "id": "grid_rcvd", "label": "Grid R", "type": "text",
      "width": 70, "required": true, "entryRow": 0,
      "validator": "maidenhead"
    },
    {
      "id": "grid_sent", "label": "Grid S", "type": "text",
      "width": 70, "required": true, "entryRow": 1,
      "persistent": true,
      "validator": "maidenhead"
    }
  ],

  "scoringRules": {
    "pointsPerQso":  1,
    "multiplierType": "grid_field",
    "scoreFormula":  "Σ QSO points (all bands) × Σ distinct 2-char grid FIELDS per band (Rule IV.A/C). QSO pts Rule IV.B: 1 + floor(km/3000) short-path between grid centers. Claimed/running score — WW Digi re-adjudicates.",
    "distanceScoring": {
      "theirGridField": "grid_rcvd",
      "ownGridField":   "grid_sent",
      "formula":        "one_plus_floor_km_div",
      "divisorKm":      3000,
      "basePoints":     1,
      "minDistancePoints": 0
    },
    "allowDupes":    false
  },

  "multiplierModel": {
    "field":   "grid_rcvd",
    "perBand": true,
    "validValues": []
  },

  "row2Panes": [
    { "paneIndex": 1, "paneType": "worked_before", "title": "Worked Before", "config": {} },
    { "paneIndex": 2, "paneType": "grid_map",      "title": "Worked Grids (per band)", "config": {} },
    { "paneIndex": 3, "paneType": "statistics",    "title": "Statistics", "config": {} }
  ],

  "statistics": ["qso_count","total_score","multipliers","qso_per_hour"],

  "cabrilloMapping": {
    "callsign":   "rcvd_callsign",
    "grid_sent":  "sent_exchange",
    "grid_rcvd":  "rcvd_exchange"
  },

  "sections": []
}

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.jlog.controller.ContestLogController"
            styleClass="main-window">

    <!-- ============================================================
         ROW 1: MENU BAR
         ============================================================ -->
    <top>
        <VBox>
            <MenuBar styleClass="menu-bar">
                <menus>
                    <Menu text="%menu.file">
                        <items>
                            <MenuItem text="%menu.file.new"    onAction="#menuNewDatabase"/>
                            <MenuItem text="%menu.file.backup" onAction="#menuBackupDatabase"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="%menu.export.cabrillo" onAction="#menuExportCabrillo"/>
                            <MenuItem text="Export ADIF…"          onAction="#menuExportAdif"/>
                            <MenuItem text="Upload to LoTW…"       onAction="#menuLotwUpload"/>
                        </items>
                    </Menu>
                    <Menu text="%menu.setup">
                        <items>
                            <MenuItem text="J-Hub Setup UI"  onAction="#menuSetup"/>
                            <MenuItem text="Macros…"         onAction="#menuMacros"/>
                            <MenuItem text="Amp Control…"    onAction="#menuAmp"/>
                            <MenuItem text="Antenna Switch…" onAction="#menuAntenna"/>
                            <MenuItem text="Log Uploaders…"  onAction="#menuUploaders"/>
                            <MenuItem text="Cloud Backup…"   onAction="#menuBackup"/>
                            <MenuItem text="J-Learn…"        onAction="#menuLearn"/>
                        </items>
                    </Menu>
                    <Menu text="%menu.contest">
                        <items>
                            <MenuItem text="%menu.contest.setup"           onAction="#menuContestSetup"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Section Map…"                  onAction="#menuSectionMap"/>
                            <MenuItem text="States/Provinces Map…"         onAction="#menuStatesMap"/>
                            <MenuItem text="World Map (DXCC)…"             onAction="#menuWorldMap"/>
                            <MenuItem text="CQ Zones Map…"                 onAction="#menuCqZonesMap"/>
                            <MenuItem text="County Map…"                   onAction="#menuCountyMap"/>
                            <MenuItem text="Grid Square Map…"              onAction="#menuGridMap"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="%menu.contest.export.cabrillo" onAction="#menuExportCabrillo"/>
                        </items>
                    </Menu>
                    <Menu text="Tools">
                        <items>
                            <MenuItem text="Translator — User Selected…" onAction="#openTranslatorUser"/>
                            <MenuItem text="Translator — DXCC Driven…"   onAction="#openTranslatorDxcc"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Priority Callsigns…"         onAction="#openPriorityCallsigns"/>
                        </items>
                    </Menu>
                    <Menu text="Help">
                        <items>
                            <MenuItem text="Report an Issue…" onAction="#menuReportIssue"/>
                        </items>
                    </Menu>
                </menus>
            </MenuBar>

            <!-- Status bar -->
            <HBox styleClass="clock-bar" spacing="16" alignment="CENTER_RIGHT">
                <padding><Insets right="12" top="2" bottom="2"/></padding>
                <Label fx:id="lblRoster"       styleClass="civ-status"/>
                <Label fx:id="lblSyncProgress" styleClass="civ-status"/>
                <Label fx:id="lblSolar"        styleClass="civ-status"/>
                <Label fx:id="lblCivStatus"    styleClass="civ-status" text="CI-V: —"/>
                <Label fx:id="lblStatus" styleClass="status-label"/>
            </HBox>

            <!-- ============================================================
                 ROW 2: DYNAMIC ENTRY BAR (built by controller) + RIG CONTROL
                 Entry bar grows; the shared Rig Control component docks to its
                 right (collapsible to a thin strip). Same component fx:included
                 by NormalLog.fxml — see RigControlController.
                 ============================================================ -->
            <HBox spacing="0" styleClass="entry-split" alignment="TOP_LEFT">
                <TitledPane text="%pane.entry" collapsible="false" styleClass="entry-pane"
                            HBox.hgrow="ALWAYS">
                    <VBox fx:id="entryBar" spacing="4">
                        <padding><Insets top="6" left="10" right="10" bottom="6"/></padding>
                    </VBox>
                </TitledPane>
                <fx:include fx:id="rig" source="RigControl.fxml"/>
            </HBox>

            <!-- Macro button bar -->
            <HBox fx:id="macroButtonBar" styleClass="macro-bar" spacing="4">
                <padding><Insets top="2" left="6" bottom="2"/></padding>
            </HBox>
        </VBox>
    </top>

    <!-- ============================================================
         CENTER: [ plugin strip + QSO table + DX spotting ]  |  side column
         The horizontal split lets the user drag the side-column width.
         The side column starts just below the entry/macro bar (which
         stay full-width in <top>) and runs to the bottom of the window.
         ============================================================ -->
    <center>
        <SplitPane fx:id="cockpitSplitPane" orientation="HORIZONTAL" dividerPositions="0.72">

            <!-- Main area: plugin-pane strip above, table/DX split below -->
            <VBox SplitPane.resizableWithParent="true">

                <HBox fx:id="row2PaneContainer" spacing="0" styleClass="plugin-pane-row"
                      minHeight="300" prefHeight="330">
                    <!-- row-placement panes built dynamically by controller -->
                </HBox>

                <SplitPane fx:id="mainSplitPane" orientation="VERTICAL" VBox.vgrow="ALWAYS">

            <!-- QSO Table -->
            <VBox styleClass="log-section">
                <HBox spacing="6" styleClass="table-toolbar">
                    <padding><Insets left="6" top="4" bottom="4"/></padding>
                    <Label text="%pane.log" styleClass="section-title"/>
                    <Button text="%button.edit"   onAction="#doEditSelected"/>
                    <Button text="%button.delete" onAction="#doDeleteSelected"/>
                    <Button text="%button.prev"   onAction="#doPageBack"/>
                    <Button text="%button.next"   onAction="#doPageForward"/>
                    <Label fx:id="lblQsoCount" styleClass="qso-count"/>
                    <Label text=" | Score: "/>
                    <Label fx:id="lblScore" styleClass="score-value"/>
                    <Label text=" | Mults: "/>
                    <Label fx:id="lblMults"  styleClass="score-value"/>
                    <Label text=" | QSO/hr: "/>
                    <Label fx:id="lblQsoHour" styleClass="score-value"/>
                </HBox>
                <TableView fx:id="qsoTable" VBox.vgrow="ALWAYS" styleClass="qso-table">
                    <columns>
                        <TableColumn fx:id="colCall"       text="%col.callsign"  prefWidth="120"/>
                        <TableColumn fx:id="colTime"       text="%col.time"      prefWidth="70"/>
                        <TableColumn fx:id="colBand"       text="%col.band"      prefWidth="55"/>
                        <TableColumn fx:id="colMode"       text="%col.mode"      prefWidth="55"/>
                        <TableColumn fx:id="colSentSerial" text="%col.serial"    prefWidth="55"/>
                        <TableColumn fx:id="colRstSent"    text="%col.rst.sent"  prefWidth="60"/>
                        <TableColumn fx:id="colRstRcvd"    text="%col.rst.rcvd"  prefWidth="60"/>
                        <TableColumn fx:id="colExchange"   text="%col.exchange"  prefWidth="170"/>
                        <TableColumn fx:id="colOp"         text="%col.operator"  prefWidth="80"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- DX Spotting -->
            <TitledPane fx:id="dxPane" text="%pane.dx" animated="false" styleClass="dx-pane">
                <fx:include source="DxSpot.fxml" fx:id="dxSpot"/>
            </TitledPane>

                </SplitPane>   <!-- /mainSplitPane (vertical) -->
            </VBox>            <!-- /main-area VBox -->

            <!-- Side column: panes a contest declares with "placement":"column".
                 The controller removes this from the split when a contest
                 declares none, so non-column contests look unchanged. -->
            <ScrollPane fx:id="sideColumnScroll" fitToWidth="true"
                        minWidth="280" prefWidth="380"
                        SplitPane.resizableWithParent="false"
                        styleClass="side-column-scroll">
                <VBox fx:id="sideColumnContainer" spacing="0" styleClass="side-column">
                    <!-- column-placement panes built dynamically by controller -->
                </VBox>
            </ScrollPane>

        </SplitPane>   <!-- /cockpitSplitPane (horizontal) -->
    </center>
</BorderPane>

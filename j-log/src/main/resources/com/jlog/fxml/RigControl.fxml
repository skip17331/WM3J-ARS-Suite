<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- Shared Rig Control component. fx:included by BOTH NormalLog.fxml
     and ContestLog.fxml. Backing controller: RigControlController.
     Extracted verbatim from the original NormalLog rig pane (2026-05-31). -->
            <TitledPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml/1"
            fx:id="rigControlPane" collapsible="true" animated="false" fx:controller="com.jlog.controller.RigControlController"
                        styleClass="entry-pane" prefWidth="380" text="">
                <!-- Title bar: "Rig Control" on the left, liveness dot +
                     status on the right. The HBox's prefWidth is bound
                     to the TitledPane's width in NormalLogController so
                     it spans the full title-bar minus the arrow inset. -->
                <graphic>
                    <HBox fx:id="rigTitleBar" alignment="CENTER_LEFT" spacing="8">
                        <Label text="Rig Control" styleClass="rig-title-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Region fx:id="rigLiveDot" prefWidth="10" prefHeight="10"
                                minWidth="10" minHeight="10" maxWidth="10" maxHeight="10"
                                styleClass="rig-dot,rig-dot-stale"/>
                        <Label fx:id="lblRigLive" text="No rig" styleClass="rig-live-label"/>
                    </HBox>
                </graphic>
                <VBox spacing="6" alignment="TOP_LEFT" styleClass="rig-pane">
                    <padding><Insets top="6" right="8" bottom="6" left="8"/></padding>

                    <!-- Top block (2x2): narrower VFO window (left) with the
                         S-meter inline to its right; tuning chevrons directly
                         under the VFO window and RIT/XIT under the S-meter. The
                         mode toolbar follows below this block. -->
                    <GridPane hgap="8" vgap="6">
                        <columnConstraints>
                            <ColumnConstraints/>
                            <ColumnConstraints/>
                            <ColumnConstraints/>
                        </columnConstraints>

                        <!-- (0,0) VFO frequency window — narrower (no longer
                             full-width; the S-meter takes the right). -->
                        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="rig-display"
                              GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <VBox spacing="2" alignment="CENTER_LEFT">
                                <Label fx:id="lblRigDisplayBand" text="Band: —"
                                       styleClass="rig-display-label"/>
                                <Label fx:id="lblRigDisplayMode" text="Mode: —"
                                       styleClass="rig-display-label"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblRigDisplayFreq" text="—"
                                   styleClass="rig-display-freq"
                                   style="-fx-font-size: 38px;"
                                   alignment="CENTER_RIGHT"/>
                        </HBox>

                        <!-- (1,0) S-meter, inline to the right of the VFO window. -->
                        <VBox styleClass="rig-meter" alignment="CENTER_LEFT"
                              minHeight="80" prefHeight="90" maxHeight="120"
                              minWidth="180" prefWidth="200" maxWidth="240" spacing="3"
                              GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <padding><Insets top="6" right="8" bottom="6" left="8"/></padding>
                            <Label text="S - METER" styleClass="rig-meter-title"/>
                            <HBox fx:id="sMeterSegments" spacing="1" alignment="CENTER_LEFT"/>
                            <Label text=" 1   3   5   7   9 +20 +40 +60"
                                   styleClass="rig-meter-tick"/>
                        </VBox>

                        <!-- (0,1) Tuning chevrons — directly under the VFO window.
                             Step set by the keypad TS button; «/» = 10x fast.
                             Tooltips live-update from refreshTsTooltip. -->
                        <HBox spacing="4" alignment="CENTER_LEFT"
                              GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="Tune:" styleClass="entry-label"/>
                            <Button fx:id="btnTuneDownFast" text="«" onAction="#tuneDownFast"
                                    styleClass="rig-keypad-btn"/>
                            <Button fx:id="btnTuneDownSlow" text="‹" onAction="#tuneDownSlow"
                                    styleClass="rig-keypad-btn"/>
                            <Button fx:id="btnTuneUpSlow" text="›" onAction="#tuneUpSlow"
                                    styleClass="rig-keypad-btn"/>
                            <Button fx:id="btnTuneUpFast" text="»" onAction="#tuneUpFast"
                                    styleClass="rig-keypad-btn"/>
                        </HBox>

                        <!-- (0,2) Mode buttons — directly under the tuning chevrons. -->
                        <HBox spacing="4" alignment="CENTER_LEFT"
                              GridPane.columnIndex="0" GridPane.rowIndex="2">
                            <Button fx:id="btnRigSet" text="SET" onAction="#rigSet"
                                    styleClass="rig-keypad-btn">
                                <tooltip><Tooltip text="Open j-hub Rig Control settings in browser"/></tooltip>
                            </Button>
                            <Button fx:id="btnRigModeSsb" text="SSB" onAction="#rigModeSsb"
                                    styleClass="rig-keypad-btn"/>
                            <Button fx:id="btnRigModeCwRtty" text="CW/RTTY" onAction="#rigModeCwRtty"
                                    styleClass="rig-keypad-btn"/>
                            <Button fx:id="btnRigModeAmFm" text="AM/FM" onAction="#rigModeAmFm"
                                    styleClass="rig-keypad-btn"/>
                            <Button fx:id="btnRigFilter" text="Filter"
                                    styleClass="rig-keypad-btn,coming-soon" disable="true">
                                <tooltip><Tooltip text="Rig filter select (coming soon)"/></tooltip>
                            </Button>
                        </HBox>

                        <!-- (1,1) RIT/XIT — right side, under the S-meter (two
                             compact lines so it fits the S-meter's width). -->
                        <VBox spacing="3" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <HBox spacing="4" alignment="CENTER_LEFT">
                                <Button fx:id="btnRigRit" text="RIT" onAction="#rigRitToggle"
                                        styleClass="rig-keypad-btn">
                                    <tooltip><Tooltip text="Toggle RIT (receive incremental tuning)"/></tooltip>
                                </Button>
                                <Button fx:id="btnRitDown" text="−" onAction="#ritDown"
                                        styleClass="rig-keypad-btn"/>
                                <Label fx:id="lblRitOffset" text="0" minWidth="34"
                                       alignment="CENTER" styleClass="rig-display-label"/>
                                <Button fx:id="btnRitUp" text="+" onAction="#ritUp"
                                        styleClass="rig-keypad-btn"/>
                            </HBox>
                            <HBox spacing="4" alignment="CENTER_LEFT">
                                <Button fx:id="btnRigXit" text="XIT" onAction="#rigXitToggle"
                                        styleClass="rig-keypad-btn">
                                    <tooltip><Tooltip text="Toggle XIT (transmit incremental tuning)"/></tooltip>
                                </Button>
                                <Button fx:id="btnXitDown" text="−" onAction="#xitDown"
                                        styleClass="rig-keypad-btn"/>
                                <Label fx:id="lblXitOffset" text="0" minWidth="34"
                                       alignment="CENTER" styleClass="rig-display-label"/>
                                <Button fx:id="btnXitUp" text="+" onAction="#xitUp"
                                        styleClass="rig-keypad-btn"/>
                            </HBox>
                        </VBox>

                        <!-- (1,2) PWR slider centered across cols 1-2 (between the
                             Filter button and the pane's right edge); (1,3)
                             Auto-track centered under it. P.AMP/NB sit at (0,3),
                             directly under the SSB/mode row. -->
                        <HBox spacing="6" alignment="CENTER"
                              GridPane.columnIndex="1" GridPane.rowIndex="2"
                              GridPane.columnSpan="2" GridPane.halignment="CENTER">
                            <Label text="PWR" styleClass="entry-label"/>
                            <Slider fx:id="sliderRfPower" min="0" max="100" prefWidth="150"/>
                            <Label fx:id="lblRfPower" text="—" minWidth="40"
                                   styleClass="rig-display-label"/>
                        </HBox>
                        <CheckBox fx:id="cbRigAutoTrack" text="Auto-track rig"
                                  GridPane.columnIndex="1" GridPane.rowIndex="3"
                                  GridPane.columnSpan="2" GridPane.halignment="CENTER"/>
                        <HBox spacing="4" alignment="CENTER_LEFT"
                              GridPane.columnIndex="0" GridPane.rowIndex="3">
                            <Button fx:id="btnRigPampAtt" text="P.AMP/ATT"
                                    styleClass="rig-keypad-btn,coming-soon" disable="true">
                                <tooltip><Tooltip text="Preamp / Attenuator (coming soon)"/></tooltip>
                            </Button>
                            <Button fx:id="btnRigNb" text="NB"
                                    styleClass="rig-keypad-btn,coming-soon" disable="true">
                                <tooltip><Tooltip text="Noise blanker (coming soon)"/></tooltip>
                            </Button>
                        </HBox>

                        <!-- (2,0) ANT 1 / ANT 2 stacked in the upper-right corner
                             of the pane (moved out of the mode toolbar). -->
                        <VBox spacing="4" alignment="TOP_LEFT"
                              GridPane.columnIndex="2" GridPane.rowIndex="0"
                              GridPane.valignment="TOP">
                            <Button fx:id="btnRigAnt1" text="ANT 1" onAction="#rigAnt1"
                                    styleClass="rig-keypad-btn"/>
                            <Button fx:id="btnRigAnt2" text="ANT 2" onAction="#rigAnt2"
                                    styleClass="rig-keypad-btn"/>
                        </VBox>

                        <!-- (2,1) Clr (clears RIT/XIT) — far right, under the
                             ANT stack, at the RIT/XIT row level. -->
                        <Button fx:id="btnRitXitClear" text="Clr" onAction="#ritXitClear"
                                styleClass="rig-keypad-btn"
                                GridPane.columnIndex="2" GridPane.rowIndex="1"
                                GridPane.valignment="TOP">
                            <tooltip><Tooltip text="Clear RIT and XIT offsets"/></tooltip>
                        </Button>
                    </GridPane>

                    <!-- Band / keypad grid (mockup rows 3-6). Each cell's
                         primary label is a band freq in MHz (1.8 = 160m,
                         3.5 = 80m, etc.); secondary "/N" is the keypad
                         digit revealed when F-INP toggles keypad mode.
                         NormalLogController dispatches each click to
                         band-jump OR digit-append based on keypadMode.
                         Fixed-width buttons — the pane does NOT stretch
                         them when the operator widens the rig area. -->
                    <!-- Keypad on the left; S-meter + tuning chevrons in a
                         right-hand column (fills the space beside the keypad). -->
                    <!-- Keypad in a collapsible, full-width pane (like Heard By /
                         DX Spotter) so the operator can fold it away to shrink
                         the pane. -->
                    <TitledPane fx:id="rigKeypadPane" text="Band / Keypad" collapsible="true" animated="false">
                    <GridPane fx:id="rigKeypad" hgap="3" vgap="3">
                        <!-- Row 0: 1.8/1   3.5/2   7/3    F-INP -->
                        <Button fx:id="btnKey1" text="1.8 / 1"
                                styleClass="rig-keypad-btn"
                                GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Button fx:id="btnKey2" text="3.5 / 2"
                                styleClass="rig-keypad-btn"
                                GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Button fx:id="btnKey3" text="7 / 3"
                                styleClass="rig-keypad-btn"
                                GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <Button fx:id="btnRigFInp" text="F-INP" onAction="#rigFInpToggle"
                                styleClass="rig-keypad-btn"
                                GridPane.columnIndex="3" GridPane.rowIndex="0">
                            <tooltip><Tooltip text="Direct frequency input — keypad mode"/></tooltip>
                        </Button>
                        <!-- Row 1: 10/4   14/5   18/6    SPLIT -->
                        <Button fx:id="btnKey4" text="10 / 4"
                                styleClass="rig-keypad-btn"
                                GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Button fx:id="btnKey5" text="14 / 5"
                                styleClass="rig-keypad-btn"
                                GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Button fx:id="btnKey6" text="18 / 6"
                                styleClass="rig-keypad-btn"
                                GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                        <Button fx:id="btnRigSplit" text="SPLIT" onAction="#rigSplitToggle"
                                styleClass="rig-keypad-btn"
                                GridPane.columnIndex="3" GridPane.rowIndex="1">
                            <tooltip><Tooltip text="Split-frequency op (TX on VFO B)"/></tooltip>
                        </Button>
                        <!-- Row 2: 21/7   24/8   28/9    A/B -->
                        <Button fx:id="btnKey7" text="21 / 7"
                                styleClass="rig-keypad-btn"
                                GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <Button fx:id="btnKey8" text="24 / 8"
                                styleClass="rig-keypad-btn"
                                GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <Button fx:id="btnKey9" text="28 / 9"
                                styleClass="rig-keypad-btn"
                                GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                        <Button fx:id="btnRigVfoSwap" text="A / B" onAction="#rigVfoSwap"
                                styleClass="rig-keypad-btn"
                                GridPane.columnIndex="3" GridPane.rowIndex="2">
                            <tooltip><Tooltip text="Swap VFO A and B (Hamlib vfo_op XCHG)"/></tooltip>
                        </Button>
                        <!-- Row 3: GENE/.   50/0   144/ENT   TS -->
                        <Button fx:id="btnKeyGen" text="GENE / ."
                                styleClass="rig-keypad-btn"
                                GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                        <Button fx:id="btnKey0" text="50 / 0"
                                styleClass="rig-keypad-btn"
                                GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        <Button fx:id="btnKeyEnt" text="144 / ENT"
                                styleClass="rig-keypad-btn"
                                GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                        <Button fx:id="btnRigTs" text="TS" onAction="#rigTsCycle"
                                styleClass="rig-keypad-btn"
                                GridPane.columnIndex="3" GridPane.rowIndex="3">
                            <tooltip><Tooltip text="Tuning Step"/></tooltip>
                        </Button>
                        <!-- Rows 4-5: extra band-only keys (no F-INP digit).
                             These generalize the keypad past the 746's HF+2m
                             set; each is capability-gated against the rig's TX
                             ranges (RIG_CAPS) exactly like the main keys, so
                             bands the rig can't reach grey out automatically. -->
                        <Button fx:id="btnBand2200" text="2200" styleClass="rig-keypad-btn"
                                GridPane.columnIndex="0" GridPane.rowIndex="4">
                            <tooltip><Tooltip text="2200 m (137 kHz)"/></tooltip>
                        </Button>
                        <Button fx:id="btnBand630" text="630" styleClass="rig-keypad-btn"
                                GridPane.columnIndex="1" GridPane.rowIndex="4">
                            <tooltip><Tooltip text="630 m (475 kHz)"/></tooltip>
                        </Button>
                        <Button fx:id="btnBand60" text="60" styleClass="rig-keypad-btn"
                                GridPane.columnIndex="2" GridPane.rowIndex="4">
                            <tooltip><Tooltip text="60 m (5.3585 MHz)"/></tooltip>
                        </Button>
                        <Button fx:id="btnBand222" text="222" styleClass="rig-keypad-btn"
                                GridPane.columnIndex="3" GridPane.rowIndex="4">
                            <tooltip><Tooltip text="1.25 m (222.1 MHz)"/></tooltip>
                        </Button>
                        <Button fx:id="btnBand70cm" text="70cm" styleClass="rig-keypad-btn"
                                GridPane.columnIndex="0" GridPane.rowIndex="5">
                            <tooltip><Tooltip text="70 cm (432.1 MHz)"/></tooltip>
                        </Button>
                        <Button fx:id="btnBand33cm" text="33cm" styleClass="rig-keypad-btn"
                                GridPane.columnIndex="1" GridPane.rowIndex="5">
                            <tooltip><Tooltip text="33 cm (902.1 MHz)"/></tooltip>
                        </Button>
                        <Button fx:id="btnBand23cm" text="23cm" styleClass="rig-keypad-btn"
                                GridPane.columnIndex="2" GridPane.rowIndex="5">
                            <tooltip><Tooltip text="23 cm (1296.1 MHz)"/></tooltip>
                        </Button>
                    </GridPane>
                    </TitledPane>
                </VBox>
            </TitledPane>

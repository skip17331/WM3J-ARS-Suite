<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.jlog.controller.NormalLogController"
            styleClass="main-window">

    <!-- ============================================================
         ROW 1: MENU BAR
         ============================================================ -->
    <top>
        <VBox>
            <MenuBar styleClass="menu-bar">
                <menus>
                    <Menu text="%menu.file">
                        <items>
                            <MenuItem text="Import ADIF…"      onAction="#menuImportAdif"/>
                            <MenuItem text="%menu.export.adif" onAction="#menuExportAdif"/>
                            <MenuItem text="%menu.export.csv"  onAction="#menuExportCsv"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Upload to LoTW…"        onAction="#menuLotwUpload"/>
                            <MenuItem text="Download LoTW QSLs…"    onAction="#menuLotwDownload"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Print QSL Cards…"       onAction="#menuPrintQsl"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="%menu.exit" onAction="#menuExit"/>
                        </items>
                    </Menu>
                    <Menu text="Awards">
                        <items>
                            <MenuItem text="Awards Dashboard…" onAction="#menuAwards"/>
                        </items>
                    </Menu>
                    <Menu text="Tools">
                        <items>
                            <CheckMenuItem fx:id="miToggleKeyer" text="CW / Digital Keyer"
                                           selected="true"
                                           onAction="#toggleKeyerPane"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Override Antenna…"      onAction="#doAntennaOverride"/>
                            <MenuItem text="Clear Antenna Override" onAction="#doAntennaOverrideClear"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Translator — User Selected…" onAction="#openTranslatorUser"/>
                            <MenuItem text="Translator — DXCC Driven…"   onAction="#openTranslatorDxcc"/>
                            <SeparatorMenuItem/>
                            <MenuItem text="Priority Callsigns…"         onAction="#openPriorityCallsigns"/>
                        </items>
                    </Menu>
                    <Menu text="%menu.setup">
                        <items>
                            <MenuItem text="J-Hub Setup UI"  onAction="#menuSetup"/>
                            <MenuItem text="Macros…"         onAction="#menuMacros"/>
                            <MenuItem text="Amp Control…"    onAction="#menuAmp"/>
                            <MenuItem text="Antenna Switch…" onAction="#menuAntenna"/>
                            <MenuItem text="Log Uploaders…"  onAction="#menuUploaders"/>
                            <MenuItem text="Cloud Backup…"   onAction="#menuBackup"/>
                            <MenuItem text="J-Learn…"        onAction="#menuLearn"/>
                        </items>
                    </Menu>
                    <Menu text="Help">
                        <items>
                            <MenuItem text="Report an Issue…" onAction="#menuReportIssue"/>
                        </items>
                    </Menu>
                </menus>
            </MenuBar>

            <!-- UTC + Local time bar -->
            <HBox styleClass="clock-bar" spacing="20" alignment="CENTER_RIGHT">
                <padding><Insets right="12" top="2" bottom="2"/></padding>
                <Label fx:id="lblStationCall" styleClass="station-call"/>
                <Label text="%label.utc" styleClass="clock-label"/>
                <TextField fx:id="tfUtcTime" styleClass="clock-field" editable="false" prefWidth="140"/>
                <Label text="%label.local" styleClass="clock-label"/>
                <TextField fx:id="tfLocalTime" styleClass="clock-field" editable="false" prefWidth="160"/>
                <Label fx:id="lblCivStatus" styleClass="civ-status" text="CI-V: —"/>
                <!-- ID timer (FCC §97.119). Shown only when enabled via j-hub's
                     J-Log card. Counts down from idTimerMinutes; flashes red when
                     due. Resets on each logged QSO or the "ID'd" button. -->
                <Label fx:id="lblIdTimer" styleClass="id-timer"
                       text="" visible="false" managed="false"/>
                <Button fx:id="btnIdReset" text="ID'd" onAction="#resetIdTimer"
                        styleClass="secondary-button"
                        visible="false" managed="false"/>
                <Label fx:id="lblAmpStatus" styleClass="amp-status"
                       text="" visible="false" managed="false"/>
                <Label fx:id="lblAntStatus" styleClass="ant-status"
                       text="" visible="false" managed="false"/>
            </HBox>
        </VBox>
    </top>

    <!-- ============================================================
         CENTER: everything below the clock bar lives in ONE vertical
         SplitPane so every row height is drag-adjustable.
           item 1 = entry area (Data Entry / Station & Space Wx / Previous
                    QSOs vertical split, beside the Rig Control pane)
           item 2 = keyer over the QSO-log/DX area (a nested vertical
                    split, so the keyer is resizable vs the log)
         The entry-split (Data Entry vs Rig Control) is a horizontal seam
         dragged via entryDragHandle.
         ============================================================ -->
    <center>
            <SplitPane fx:id="rowSplit" orientation="VERTICAL"
                       styleClass="row-split" dividerPositions="0.5">
            <!-- item 1: entry area. The StackPane lets entryDragHandle overlay
                 the Data Entry / Rig Control seam. -->
            <VBox spacing="0">
            <StackPane VBox.vgrow="ALWAYS">
            <!-- maxHeight=Infinity lets the StackPane stretch this row to fill
                 the available height (down to the macro bar) so the left
                 column's Previous QSOs pane can grow into it. -->
            <HBox spacing="0" styleClass="entry-split" maxHeight="Infinity">
            <!-- Left column: Data Entry with Station Info / Bearing-Distance /
                 Space Wx directly beneath it (filling the space left of the
                 taller Rig Control pane). -->
            <!-- Vertical SplitPane: Data Entry / Station & Space Wx / Previous
                 QSOs are now drag-resizable (vertical). Horizontal resize of the
                 whole column vs the Rig Control pane is the entryDragHandle. -->
            <SplitPane orientation="VERTICAL" HBox.hgrow="ALWAYS" prefWidth="1000"
                       maxHeight="Infinity" dividerPositions="0.35, 0.55"
                       styleClass="left-col-split">
            <TitledPane fx:id="entryPane" text="%pane.entry" collapsible="false" styleClass="entry-pane">
                <VBox spacing="6">
                <GridPane hgap="8" vgap="6" styleClass="entry-grid">
                    <padding><Insets top="8" left="10" right="10" bottom="8"/></padding>

                    <!-- Row 0: Callsign, Band, Mode, Power, RST Sent, RST Rcvd -->
                    <Label text="%label.callsign" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="tfCallsign" styleClass="callsign-field"
                               GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="130"/>

                    <Label text="%label.band" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <TextField fx:id="tfBand" GridPane.columnIndex="3" GridPane.rowIndex="0" prefWidth="80" promptText="band"/>

                    <Label text="%label.mode" GridPane.columnIndex="4" GridPane.rowIndex="0"/>
                    <TextField fx:id="tfMode" GridPane.columnIndex="5" GridPane.rowIndex="0" prefWidth="90" promptText="mode"/>

                    <Label text="%label.power" GridPane.columnIndex="6" GridPane.rowIndex="0"/>
                    <TextField fx:id="tfPower" GridPane.columnIndex="7" GridPane.rowIndex="0" prefWidth="60"/>

                    <Label text="%label.rst.sent" GridPane.columnIndex="8" GridPane.rowIndex="0"/>
                    <TextField fx:id="tfRstSent" GridPane.columnIndex="9" GridPane.rowIndex="0" prefWidth="50"/>

                    <Label text="%label.rst.rcvd" GridPane.columnIndex="10" GridPane.rowIndex="0"/>
                    <TextField fx:id="tfRstReceived" GridPane.columnIndex="11" GridPane.rowIndex="0" prefWidth="50"/>

                    <!-- Row 1: Country, Name, State, County, Frequency -->
                    <Label text="%label.country" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="tfCountry" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="130"/>

                    <Label text="%label.name" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <TextField fx:id="tfOperatorName" GridPane.columnIndex="3" GridPane.rowIndex="1"
                               prefWidth="140" GridPane.columnSpan="2"/>

                    <Label text="%label.state" GridPane.columnIndex="5" GridPane.rowIndex="1"/>
                    <TextField fx:id="tfState" GridPane.columnIndex="6" GridPane.rowIndex="1" prefWidth="60"/>

                    <Label text="%label.county" GridPane.columnIndex="7" GridPane.rowIndex="1"/>
                    <TextField fx:id="tfCounty" GridPane.columnIndex="8" GridPane.rowIndex="1" prefWidth="100"/>

                    <Label text="%label.freq" GridPane.columnIndex="9" GridPane.rowIndex="1"/>
                    <TextField fx:id="tfFrequency" GridPane.columnIndex="10" GridPane.rowIndex="1" prefWidth="90"/>
                    <Button text="Band Plan" onAction="#showBandPlan"
                            styleClass="secondary-button"
                            GridPane.columnIndex="11" GridPane.rowIndex="1"/>

                    <!-- Row 2: Notes, QSL, Buttons -->
                    <Label text="%label.notes" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="tfNotes" GridPane.columnIndex="1" GridPane.rowIndex="2"
                               GridPane.columnSpan="5" prefWidth="300"/>

                    <CheckBox fx:id="cbQslSent"     text="%label.qsl.sent"
                              GridPane.columnIndex="6" GridPane.rowIndex="2"/>
                    <CheckBox fx:id="cbQslReceived" text="%label.qsl.rcvd"
                              GridPane.columnIndex="7" GridPane.rowIndex="2"/>

                    <HBox GridPane.columnIndex="8" GridPane.rowIndex="2"
                          GridPane.columnSpan="4" spacing="6">
                        <Button fx:id="btnSave" text="%button.save"   onAction="#doSave"            styleClass="primary-button"/>
                        <Button text="%button.clear"  onAction="#doClear"           styleClass="secondary-button"/>
                        <Button text="%button.lookup" onAction="#doCallsignLookup"  styleClass="secondary-button"/>
                    </HBox>

                    <!-- Row 3: Band / mode warning bar (hidden when no warning) -->
                    <Label fx:id="lblBandWarning" styleClass="band-warning"
                           visible="false" managed="false"
                           GridPane.columnIndex="0" GridPane.rowIndex="3"
                           GridPane.columnSpan="12" maxWidth="Infinity"/>
                </GridPane>

                </VBox>
            </TitledPane>

            <!-- Station Info / Bearing / Space Wx in ONE collapsible pane (the
                 whole row folds away). Flattened: the three sections are plain
                 labelled columns, NOT nested TitledPanes, so nothing looks like
                 a pane floating inside a pane. Station Info expands right
                 (hgrow); the others size to content. -->
            <TitledPane text="Station &amp; Space Wx" collapsible="true" animated="false">
            <HBox styleClass="info-pane-row" spacing="20">
                <padding><Insets top="4" right="8" bottom="6" left="8"/></padding>
                <!-- Station Info (left) -->
                <VBox spacing="3" styleClass="info-content">
                    <Label text="%pane.info" styleClass="section-title"/>
                    <HBox spacing="8">
                        <Label text="%label.country"/>
                        <Label fx:id="lblCountry" styleClass="info-value"/>
                    </HBox>
                    <HBox spacing="8">
                        <Label text="%label.continent"/>
                        <Label fx:id="lblContinent" styleClass="info-value"/>
                    </HBox>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <!-- Bearing / Distance (centered between Station Info & Space Wx
                     by the equal flexible spacers on either side) -->
                <VBox spacing="3" styleClass="info-content">
                    <Label text="%pane.bearing" styleClass="section-title"/>
                    <HBox spacing="8">
                        <Label text="%label.bearing"/>
                        <Label fx:id="lblBearing" styleClass="info-value"/>
                    </HBox>
                    <HBox spacing="8">
                        <Label text="%label.distance"/>
                        <Label fx:id="lblDistance" styleClass="info-value"/>
                    </HBox>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <!-- Space Wx (right) — fx:id moved here from the old inner pane;
                     shown/hidden via the showSpaceWeather setting. -->
                <VBox fx:id="spaceWxPane" spacing="3" styleClass="info-content">
                    <Label text="Space Wx" styleClass="section-title"/>
                    <GridPane hgap="14" vgap="4">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" minWidth="42"/>
                            <ColumnConstraints halignment="LEFT"  minWidth="50"/>
                            <ColumnConstraints halignment="RIGHT" minWidth="42"/>
                            <ColumnConstraints halignment="LEFT"  minWidth="60"/>
                            <ColumnConstraints halignment="RIGHT" minWidth="42"/>
                            <ColumnConstraints halignment="LEFT"  minWidth="50"/>
                        </columnConstraints>

                        <!-- Row 0 — SFI | K | SSN -->
                        <Label text="SFI:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Label fx:id="lblSolarSfi" styleClass="info-value"
                               GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="K:"   GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <Label fx:id="lblSolarK"   styleClass="info-value"
                               GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                        <Label text="SSN:" GridPane.columnIndex="4" GridPane.rowIndex="0"/>
                        <Label fx:id="lblSolarSsn" styleClass="info-value"
                               GridPane.columnIndex="5" GridPane.rowIndex="0"/>

                        <!-- Row 1 — X-Ray | Wind | Geomag -->
                        <Label text="X-Ray:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Label fx:id="lblSolarXray" styleClass="info-value"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label text="Wind:"  GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                        <Label fx:id="lblSolarWind" styleClass="info-value"
                               GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                        <Label text="Geo:"   GridPane.columnIndex="4" GridPane.rowIndex="1"/>
                        <Label fx:id="lblSolarGeo"  styleClass="info-value"
                               GridPane.columnIndex="5" GridPane.rowIndex="1"/>
                    </GridPane>
                </VBox>
            </HBox>
            </TitledPane>

            <!-- Previous QSOs — directly under the Station Info / Bearing /
                 Space Wx row (moved up from the old full-width lower row). -->
            <!-- Grows downward (VBox.vgrow) to fill the left column's leftover
                 height, ending just above the F1-F12 macro bar. -->
            <TitledPane fx:id="prevQsosPane" text="Previous QSOs" collapsible="true" animated="false"
                        VBox.vgrow="ALWAYS" maxHeight="Infinity">
                <TableView fx:id="prevQsosTable" styleClass="qso-table" prefHeight="240" minHeight="40">
                    <columns>
                        <TableColumn fx:id="colPqDate"  text="Date / Time" prefWidth="120"/>
                        <TableColumn fx:id="colPqBand"  text="Band"        prefWidth="55"/>
                        <TableColumn fx:id="colPqMode"  text="Mode"        prefWidth="60"/>
                        <TableColumn fx:id="colPqRstS"  text="RST S"       prefWidth="50"/>
                        <TableColumn fx:id="colPqRstR"  text="RST R"       prefWidth="50"/>
                        <TableColumn fx:id="colPqState" text="State"       prefWidth="60"/>
                        <TableColumn fx:id="colPqNotes" text="Notes"       prefWidth="160"/>
                    </columns>
                </TableView>
            </TitledPane>
            </SplitPane>

            <!-- Shared Rig Control component (RigControl.fxml + RigControlController),
                 also fx:included by ContestLog.fxml. Single source of truth. -->
            <fx:include fx:id="rig" source="RigControl.fxml"/>
            </HBox>
            <!-- Invisible draggable strip overlaid on the Data Entry / Rig
                 Control seam. 6px wide, transparent, H_RESIZE cursor. The
                 controller binds translateX to entryPane.width-3 so it
                 tracks the seam as the operator drags. -->
            <Region fx:id="entryDragHandle" prefWidth="6"
                    minWidth="6" maxWidth="6"
                    maxHeight="Infinity" pickOnBounds="true"
                    StackPane.alignment="TOP_LEFT"
                    style="-fx-cursor: H_RESIZE; -fx-background-color: transparent;"/>
            </StackPane>

            <!-- Macro button bar moved into the keyer pane (toggled with it). -->

            <!-- F1-F12 macro buttons. NormalLogController.initMacroBar()
                 populates this HBox with one Button per slot. Lives in the
                 rowSplit's top VBox so it sits directly above the Station
                 Info banner (per WM3J 2026-05-29 layout). -->
            <HBox fx:id="macroButtonBar" styleClass="macro-bar" spacing="4"
                  alignment="CENTER_LEFT"/>
            </VBox>

            <!-- item 2: keyer over the QSO-log/DX area, as a nested vertical
                 SplitPane so the keyer is drag-resizable vs the log. The keyer
                 is toggled via the Tools menu — added to / removed from this
                 split's items in toggleKeyerPane (managed/visible alone leaves
                 a dead divider gap in a SplitPane). -->
            <SplitPane fx:id="centerSplit" orientation="VERTICAL" dividerPositions="0.22">
            <VBox fx:id="keyerPane" spacing="4" styleClass="keyer-pane"
                  minHeight="80">
                <padding><Insets top="4" right="6" bottom="4" left="6"/></padding>
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="Keyer:" styleClass="section-title"/>
                    <ComboBox fx:id="cbKeyerMode" prefWidth="90"/>
                    <Label fx:id="lblCwWpm" text="WPM:"/>
                    <Spinner fx:id="spCwWpm" prefWidth="70" editable="true"/>
                    <TextArea fx:id="taKeyerRx" editable="false" wrapText="true"
                              prefRowCount="3" HBox.hgrow="ALWAYS"
                              promptText="Decoded text — select a callsign, right-click to use it"/>
                </HBox>
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <Label text="TX:"/>
                    <TextField fx:id="tfKeyerTx" HBox.hgrow="ALWAYS"
                               promptText="Type and press Enter or Send"/>
                    <Button fx:id="btnKeyerSend"  text="Send"  onAction="#doKeyerSend"  styleClass="primary-button"/>
                    <Button fx:id="btnKeyerClear" text="Clear" onAction="#doKeyerClear" styleClass="secondary-button"/>
                    <Label fx:id="lblKeyerStatus" styleClass="status-label"/>
                </HBox>
            </VBox>

            <SplitPane fx:id="mainSplitPane" orientation="HORIZONTAL"
                       dividerPositions="0.66" VBox.vgrow="ALWAYS">
            <!-- LEFT: QSO log + collapsible Keyer pane underneath -->
            <VBox styleClass="log-section">
                <HBox spacing="6" styleClass="table-toolbar">
                    <padding><Insets left="6" top="4" bottom="4"/></padding>
                    <Label text="%pane.log" styleClass="section-title"/>
                    <Button text="%button.edit"      onAction="#doEditSelected"/>
                    <Button text="%button.save.edit" onAction="#doSaveEdited"/>
                    <Button text="%button.delete"    onAction="#doDeleteSelected"/>
                    <Button text="%button.prev"      onAction="#doPageBack"/>
                    <Button text="%button.next"      onAction="#doPageForward"/>
                    <Label text="Sort:"/>
                    <ChoiceBox fx:id="cbSortOrder" prefWidth="140"/>
                    <Label fx:id="lblStatus" styleClass="status-label" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
                <TableView fx:id="qsoTable" VBox.vgrow="ALWAYS" styleClass="qso-table">
                    <columns>
                        <TableColumn fx:id="colCallsign" text="%col.callsign" prefWidth="120"/>
                        <TableColumn fx:id="colDate"     text="%col.date"     prefWidth="140"/>
                        <TableColumn fx:id="colBand"     text="%col.band"     prefWidth="60"/>
                        <TableColumn fx:id="colMode"     text="%col.mode"     prefWidth="70"/>
                        <TableColumn fx:id="colRstSent"  text="%col.rst.sent" prefWidth="60"/>
                        <TableColumn fx:id="colRstRcvd"  text="%col.rst.rcvd" prefWidth="60"/>
                        <TableColumn fx:id="colCountry"  text="%col.country"  prefWidth="130"/>
                        <TableColumn fx:id="colNotes"    text="%col.notes"    prefWidth="200"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- RIGHT: DX Spotting (always expanded) + Heard-By (collapsible).
                 Operator can drag the divider to give either side more room. -->
            <VBox spacing="0">
                <TitledPane fx:id="dxPane" text="%pane.dx" animated="false" styleClass="dx-pane"
                            VBox.vgrow="ALWAYS">
                    <fx:include source="DxSpot.fxml" fx:id="dxSpot"/>
                </TitledPane>

                <!-- Heard-By pane: who is currently hearing us (PSK Reporter
                     + WSPR). Collapsed by default to keep the column clean. -->
                <TitledPane fx:id="heardByPane" text="Heard By" animated="false"
                            collapsible="true" expanded="false" styleClass="dx-pane">
                    <TableView fx:id="heardByTable" styleClass="qso-table" prefHeight="220">
                        <columns>
                            <TableColumn fx:id="colHbTime"     text="Time"     prefWidth="80"/>
                            <TableColumn fx:id="colHbReporter" text="Reporter" prefWidth="100"/>
                            <TableColumn fx:id="colHbGrid"     text="Grid"     prefWidth="70"/>
                            <TableColumn fx:id="colHbBand"     text="Band"     prefWidth="60"/>
                            <TableColumn fx:id="colHbMode"     text="Mode"     prefWidth="70"/>
                            <TableColumn fx:id="colHbSnr"      text="SNR"      prefWidth="55"/>
                            <TableColumn fx:id="colHbSource"   text="Source"   prefWidth="90"/>
                        </columns>
                    </TableView>
                </TitledPane>
            </VBox>
        </SplitPane>
            </SplitPane>
            </SplitPane>
    </center>
</BorderPane>

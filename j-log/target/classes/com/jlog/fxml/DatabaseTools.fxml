<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jlog.controller.DatabaseToolsController"
      styleClass="main-window" spacing="0" prefWidth="380">

    <!-- Header -->
    <HBox styleClass="clock-bar" alignment="CENTER_LEFT">
        <padding><Insets top="8" left="12" right="12" bottom="8"/></padding>
        <Label text="DATABASE TOOLS" styleClass="section-title"/>
    </HBox>

    <!-- Database Management -->
    <TitledPane text="Database Management" collapsible="false" styleClass="entry-pane">
        <GridPane hgap="8" vgap="8" styleClass="entry-grid">
            <padding><Insets top="10" left="12" right="12" bottom="12"/></padding>

            <!-- Row 0: Database selector -->
            <Label text="Database:" styleClass="entry-label"
                   GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <ComboBox fx:id="cbDatabase" prefWidth="200"
                      GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Button text="↺" onAction="#doRefreshDatabases" styleClass="secondary-button"
                    GridPane.columnIndex="2" GridPane.rowIndex="0"/>

            <!-- Row 1: Action buttons -->
            <HBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1"
                  GridPane.columnSpan="3">
                <Button text="Add Database"    onAction="#doAddDatabase"    styleClass="secondary-button" prefWidth="112"/>
                <Button text="Select Database" onAction="#doSelectDatabase" styleClass="primary-button"   prefWidth="112"/>
                <Button text="Delete Database" onAction="#doDeleteDatabase" styleClass="secondary-button" prefWidth="112"/>
            </HBox>

            <!-- Row 2: Status -->
            <Label fx:id="lblDbStatus" styleClass="status-label"
                   GridPane.columnIndex="0" GridPane.rowIndex="2"
                   GridPane.columnSpan="3" maxWidth="Infinity"/>
        </GridPane>
    </TitledPane>

    <!-- Export -->
    <TitledPane text="Export Log" collapsible="false" styleClass="entry-pane">
        <GridPane hgap="8" vgap="8" styleClass="entry-grid">
            <padding><Insets top="10" left="12" right="12" bottom="12"/></padding>

            <HBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0"
                  GridPane.columnSpan="2">
                <Button text="Export ADIF" onAction="#doExportAdif" styleClass="secondary-button" prefWidth="170"/>
                <Button text="Export CSV"  onAction="#doExportCsv"  styleClass="secondary-button" prefWidth="170"/>
            </HBox>

            <Label fx:id="lblExportStatus" styleClass="status-label"
                   GridPane.columnIndex="0" GridPane.rowIndex="1"
                   GridPane.columnSpan="2" maxWidth="Infinity"/>
        </GridPane>
    </TitledPane>

    <!-- Close button row -->
    <HBox alignment="CENTER_RIGHT" spacing="8">
        <padding><Insets top="10" right="12" bottom="12"/></padding>
        <Button text="Close" onAction="#doClose" styleClass="secondary-button" prefWidth="80"/>
    </HBox>
</VBox>

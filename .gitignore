# Maven build outputs
target/
*.class
dependency-reduced-pom.xml

# IDE
.idea/
*.iml
.vscode/
.project
.classpath
.settings/

# OS
.DS_Store
Thumbs.db

# Java crash dumps
hs_err_pid*.log
replay_pid*.log

# Claude Code local state
.claude/

# Python bytecode (test-suite generators)
__pycache__/
*.pyc

# Python virtualenvs (per-machine, rebuilt from requirements.txt)
.venv/
venv/

# Bulk geographic data (shapefile inputs, if any are pulled locally)
*.shp
*.shx
*.dbf
*.prj
*.cpg

# Obsolete per-module JavaFX vendoring — JavaFX is now bundled into each
# module's fat jar via the OS-classifier Maven deps, so lib/javafx and
# lib/bin are no longer used or shipped. Ignored so a stale script or an
# old install can't reintroduce them into version control.
*/lib/javafx/
*/lib/bin/
*/lib/

# Installer-generated Windows icons. Source icons are PNG (in each
# module's resources); the installer derives a per-module .ico at
# install time, so .ico is always a build artifact, never committed.
*.ico

# Unified Windows installer transcript (per-machine, for bug reports)
install-log.txt

# Per-machine j-hub runtime config. j-hub writes j-hub.json into its
# working directory (and modules launched from j-hub can drop one in
# theirs), so it appears under several module dirs. It is auto-created
# with OS-correct defaults on first run — committing it ships stale
# (often Linux) launch commands to every clone. Ignore it everywhere.
j-hub.json

# Runtime logs / state
/logs/
j-digi/logs/
j-bridge/logs/
j-hub/logs/
j-learn/logs/
j-log/logs/
j-log-engine/logs/
j-map/logs/
j-sat/logs/
j-vault/logs/
morse-trainer/logs/
git-sync.log

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jwae.app.MainController"
      spacing="8">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

    <Label fx:id="lblContest" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

    <HBox spacing="8">
        <Button text="Refresh" onAction="#refresh"/>
        <Label fx:id="lblCount"/>
    </HBox>

    <TableView fx:id="qtcTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colDir"    text="Dir"    prefWidth="60"/>
            <TableColumn fx:id="colPeer"   text="Peer"   prefWidth="130"/>
            <TableColumn fx:id="colTime"   text="Time"   prefWidth="100"/>
            <TableColumn fx:id="colCall"   text="QTC Call"   prefWidth="130"/>
            <TableColumn fx:id="colSerial" text="QTC Serial" prefWidth="100"/>
        </columns>
    </TableView>

    <Label text="Skeleton only. Future work: live QSO pairing, 10-QTC-per-peer enforcement, send/receive workflow, Cabrillo QTC lines."
           style="-fx-font-style: italic; -fx-text-fill: gray; -fx-font-size: 11px;"
           wrapText="true"/>
</VBox>
